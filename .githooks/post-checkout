#!/usr/bin/env bash
# post-checkout hook: run via hk (lifecycle wrapper)
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

if ! command -v hk >/dev/null 2>&1; then
    echo "post-checkout: hk is required but not found. Run 'mise install'." >&2
    exit 0
fi

hk run post-checkout "$@"
