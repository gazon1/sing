#!/usr/bin/env bash
# Post-checkout hook: cleans stale Gradle outputs after branch/checkout changes.
#
# Triggered after `git checkout`, `git switch`, and `git worktree add`.
# Arguments: $1=previous_HEAD $2=new_HEAD $3=1 (branch) or $3=0 (file)
#
# In worktrees this is especially important — switching branches in a worktree
# can leave stale .class / build/ artifacts that cause incremental compilation
# to produce incorrect output (e.g., class file for a deleted class lingers).
#
# Only runs when checking out a branch (not individual files).
# Fast: cleans only stale build dirs, not the entire build/.
# Use `git clean -df` manually for a full reset.

set -euo pipefail

if [ "$3" != "1" ]; then
    # File-level checkout — skip (e.g., `git checkout -- file.txt`)
    exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

PREV="$1"
NEW="$2"

echo "=== Post-checkout: cleaning stale build outputs ==="

# Clean build/ directories that might contain stale incremental-compilation artifacts
# for the shared module (KMP compiles to jvmTest/ and androidHostTest/ variants).
# This is safe — Gradle will rebuild what's needed on next `./gradlew`.
find "$REPO_ROOT/shared/build" \
    -maxdepth 1 \
    -type d \
    \( -name "classes" -o -name "tmp" -o -name "generated" -o -name "reports" \) \
    -prune \
    -exec rm -rf {} + 2>/dev/null || true

find "$REPO_ROOT/desktopApp/build" \
    -maxdepth 1 \
    -type d \
    \( -name "classes" -o -name "tmp" -o -name "generated" -o -name "reports" \) \
    -prune \
    -exec rm -rf {} + 2>/dev/null || true

find "$REPO_ROOT/mcp-server/build" \
    -maxdepth 1 \
    -type d \
    \( -name "classes" -o -name "tmp" -o -name "generated" -o -name "reports" \) \
    -prune \
    -exec rm -rf {} + 2>/dev/null || true

echo "=== Post-checkout done ==="
