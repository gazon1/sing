#!/usr/bin/env bash
# post-merge hook: run via hk (lifecycle wrapper)
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

if ! command -v hk >/dev/null 2>&1; then
    if command -v mise >/dev/null 2>&1; then
        echo "post-merge: hk not found — running 'mise install'..." >&2
        mise install >&2 || true
    fi
fi

if ! command -v hk >/dev/null 2>&1; then
    echo "post-merge: hk is required but not found. Run 'mise install'." >&2
    exit 0
fi

hk run post-merge "$@"
