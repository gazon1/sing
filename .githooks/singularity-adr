#!/usr/bin/env bash
#
# singularity-adr — запустить ADR-CLI в текущем checkout.
#
# Зачем обёртка, а не симлинк на один готовый бинарь:
#
#  * Воркtree'ев много, и у каждого свой `adr-cli/build/`. Симлинк на чужой
#    воркtree указывал бы на сборку того воркtree'а — а он может быть
#    переключён на другую ветку или снесён `gradle clean`.
#  * ADR-CLI находит корпус по текущему каталогу, а не по своему расположению.
#    Значит бинарь должен соответствовать тому checkout, из которого вызвали.
#
# Почему пересборка условная, а не на каждый вызов:
#
# Безусловный `:adr-cli:installDist` инкрементален, но всё равно стоит ~600 мс —
# это утраивает время команды, которая сама работает 250 мс. При этом выигрыш
# не в том, что бинарь всегда свежий, а в том, что его не нужно обновлять
# руками: забытый `installDist` даёт CLI, который тихо отвечает по старым
# правилам, и это хуже, чем полсекунды.
#
# Поэтому сравниваются mtime. `:adr-cli` зависит только от `:adr-core`,
# `:core-base` и каталога версий — этого списка достаточно, чтобы поймать любую
# правку, способную изменить поведение. Всё, что не попало в пересборку, попадёт
# при следующем вызове: список покрывает ровно дерево зависимостей модуля.
set -euo pipefail

root="$(git rev-parse --show-toplevel 2>/dev/null)" || {
  echo "singularity-adr: не внутри git-репозитория — запускайте из воркtree" >&2
  exit 2
}

dist="$root/adr-cli/build/install/singularity-adr/bin/singularity-adr"

# Ищем первый файл новее бинаря. Список — дерево зависимостей `:adr-cli`.
needs_build=0
if [[ ! -x "$dist" ]]; then
  needs_build=1
else
  # Отдельные файлы проверяем по имени, а не по расширению: `libs.versions.toml`
  # не совпал бы ни с `*.kt`, ни с `*.kts`, и смена версии зависимости прошла
  # бы незамеченной.
  for f in "$root/adr-cli/build.gradle.kts" "$root/gradle/libs.versions.toml"; do
    if [[ "$f" -nt "$dist" ]]; then needs_build=1; break; fi
  done
fi

if ((needs_build == 0)) && [[ -x "$dist" ]]; then
  newer="$(find "$root/adr-cli/src" "$root/adr-core/src" "$root/core-base/src" \
               -type f \( -name '*.kt' -o -name '*.kts' \) -newer "$dist" \
               -print -quit 2>/dev/null || true)"
  [[ -n "$newer" ]] && needs_build=1
fi

if ((needs_build)); then
  "$root/gradlew" -p "$root" :adr-cli:installDist --quiet >&2
  # Gradle не переписывает лаунчер-скрипт, если тот не изменился, — значит его
  # mtime остаётся старше правки, которая вызвала сборку. Без этой метки
  # следующий вызов увидит «источник новее бинаря» и пересоберётся снова, то
  # есть всегда. Метка ставится только после успешной сборки.
  touch "$dist"
fi

exec "$dist" "$@"