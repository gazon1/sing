#!/usr/bin/env bash
# Pre-commit hook: compile before commit.
#
# Formatting (detekt + ktlint) is handled by CI — running it in the hook is
# redundant and the auto-correct pass can't fix certain ktlint issues (e.g. minor
# whitespace / trailing-comma style nits), which would block commits for no reason.
#
# Use `git commit --no-verify` to skip when needed.

set -e

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# Skip when inside a git worktree. This is no longer a correctness workaround
# (ROOT is resolved from Git, so the hook now sees the worktree's own source);
# it stays because a full compile on every commit is several minutes, and CI
# compiles anyway.
if [ "$(git rev-parse --git-dir)" != "$(git rev-parse --git-common-dir)" ]; then
    echo "=== Pre-commit: skipped (worktree) ==="
    exit 0
fi

echo "=== Pre-commit: compiling shared (main + test) ==="
./gradlew :shared:compileKotlinJvm :shared:compileTestKotlinJvm --no-daemon --quiet || {
    echo "shared:compileKotlinJvm or :shared:compileTestKotlinJvm FAILED"
    exit 1
}

echo "=== Pre-commit: compiling desktop ==="
./gradlew :desktopApp:compileKotlin --no-daemon --quiet || {
    echo ":desktopApp:compileKotlin FAILED"
    exit 1
}

echo "=== Pre-commit OK ==="
