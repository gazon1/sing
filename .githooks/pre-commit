#!/usr/bin/env bash
# Pre-commit hook: auto-fix formatting, then compile before commit.
#
# Runs detekt --auto-correct FIRST (fixes ktlint formatting), THEN compiles.
# This way formatting changes are included in the commit and don't cause
# compilation failures downstream.
#
# Use `git commit --no-verify` to skip when needed.

set -e

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

# Skip when inside a git worktree — the hook runs against the main
# checkout's source set, so any worktree that is API-ahead of main will produce
# spurious "unresolved reference" errors and block the worktree commit.
if [ "$(git rev-parse --git-dir)" != "$(git rev-parse --git-common-dir)" ]; then
    echo "=== Pre-commit: skipped (worktree) ==="
    exit 0
fi

echo "=== Pre-commit: auto-fix detekt + ktlint formatting ==="
./gradlew :shared:detekt :desktopApp:detekt --auto-correct --no-daemon --quiet || {
    echo "detekt --auto-correct FAILED"
    exit 1
}

echo "=== Pre-commit: compiling shared (main + test) ==="
./gradlew :shared:compileKotlinJvm :shared:compileTestKotlinJvm --no-daemon --quiet || {
    echo "shared:compileKotlinJvm or :shared:compileTestKotlinJvm FAILED"
    exit 1
}

echo "=== Pre-commit: compiling desktop ==="
./gradlew :desktopApp:compileKotlin --no-daemon --quiet || {
    echo ":desktopApp:compileKotlin FAILED"
    exit 1
}

echo "=== Pre-commit OK ==="
