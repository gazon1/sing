#!/usr/bin/env bash
# Pre-commit hook: lint the changed files, then compile.
#
# Two steps, and they answer two different questions:
#
#   1. `lint-changed` — detekt over the changed files only. The same config,
#      the same baseline and the same rules as the module's own detekt task, so
#      a finding here is the finding CI reports. The whole-module detekt stays
#      in CI (the auto-correct pass there can't fix certain ktlint issues —
#      e.g. minor whitespace / trailing-comma style nits — which would block
#      commits for no reason); what is added here is the seconds-long check on
#      the file that was just written, because a mechanical finding — a
#      too-complex method, a long method, a missing blank line — is a finding
#      about that file and nothing else.
#   2. `compile-changed` — the compile of the modules the change TOUCHES. The
#      set is computed from the module graph (`scripts/changed-modules.py`),
#      the same graph the local verification plan and the pre-push detekt
#      verdict read: a change in a module compiles that module, a change to
#      the build compiles everything, and a change that touches no module
#      compiles nothing.
#
# What is checked: the tree that is about to be committed.
# What is not: the modules the change does not touch. CI compiles every
# module; this compiles the ones the change is made of.
#
# The tree that is about to be committed is the INDEX, and the hook makes the
# working tree carry it while the check runs: the unstaged changes are put
# aside by `scripts/staged-tree.py` and put back afterwards. Without that, a
# commit on a branch with one commit per idea is refused for the next idea's
# breakage — files the commit does not contain. The pre-push hook checks the
# tree being pushed the same way; a commit cannot afford a throwaway worktree,
# because a worktree's build directory is cold.
#
# Use `git commit --no-verify` to skip when needed — and know that you are
# then the check that did not run.

set -e

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# The hook compiles here, in a worktree, exactly as it does in the main
# checkout.
#
# It used to skip: a linked worktree exited 0 without compiling anything, and
# a linked worktree is this repository's MAIN working mode. The cost of the
# compile is the reason that skip was there — a full compile is minutes — but
# the compile is incremental, and a worktree's own Gradle home keeps the
# configuration cache warm: once the worktree is warm, a commit that changes no
# Kotlin source costs seconds, not minutes. The cold price is paid once, by the
# first commit in the worktree.
#
# What the skip bought was a commit that does not compile. The breakage was
# found in CI — or, when the merge went through without CI, not at all: a
# Kotlin test was changed in a worktree, the commit passed because nothing was
# compiled, and the merge reached main unverified. ADR
# 2026-09-25-git-hooks-worktree-isolation says worktrees get a "compile-only"
# check; the implementation gave them nothing, and this is where the two are
# made to agree.
#
# The price of the check is the commit's wait. It is written down here so it
# reads as a decision: the wait is the price of knowing the commit compiles.
#
# The wait is also now scoped. The hook used to compile `:shared` and
# `:desktopApp` for every commit, whatever the change was: a change to a gate
# script or a document paid for a Kotlin compile that could not say anything
# about it, and a change that did not touch those modules was blocked by
# somebody else's breakage in them. The compile follows the change now — see
# ADR 2026-10-23-the-commit-compiles-what-the-change-reaches.md.

echo "=== Pre-commit: holding the working tree at the index ==="
# What is checked is the tree the commit carries — the index — and not the
# working tree. On a branch with one commit per idea the working tree usually
# holds the next idea as well, and a compile that saw the next idea refused
# this commit for a reason that belonged to another change: the commit was
# blocked on files it does not contain, and the person committing had to work
# out which half broke it.
#
# The unstaged work is put aside while the check runs, and put back after it.
# The pre-push hook has the same shape — it checks the tree being pushed — but
# it can afford a throwaway worktree, because a push is rare. A commit is not
# rare, and a worktree has its own build directory: a compile there starts
# cold, and the price of every commit would be a full build. So the working
# tree is held in place instead — same directory, same warm cache, same speed.
#
# The restore runs on every exit path, including a failure and an interrupt.
# The held bytes are somebody's uncommitted work, and a hook that keeps them is
# a hook that loses them.
PLAN_DIR="$(mktemp -d "${TMPDIR:-/tmp}/pre-commit-staged-XXXXXX")"
PLAN="$PLAN_DIR/plan.json"
# The helper is copied OUT of the tree before the tree is held. The helper
# itself may be an untracked file — the first commit that adds it is exactly
# that — and a held tree has no helper in it to restore the tree with. A
# restore that cannot run is a restore that does not happen, so the copy
# lives where the hold cannot reach it.
cp scripts/staged-tree.py "$PLAN_DIR/staged-tree.py"

restore_held_tree() {
    local rc=$?
    local restored=1
    if [ -f "$PLAN" ]; then
        echo "=== Pre-commit: restoring the working tree ==="
        python3 "$PLAN_DIR/staged-tree.py" restore --root "$ROOT" --plan "$PLAN" || restored=0
    fi
    if [ "$restored" -eq 0 ]; then
        # The held bytes are somebody's uncommitted work, so a failed restore
        # must not take them with it. The holder is left in place, and the old
        # message — which said "Nothing is lost" and then deleted the holder —
        # told the opposite of what the next line did.
        echo "" >&2
        echo "pre-commit: the held work could not be put back automatically." >&2
        echo "It is still in ${PLAN_DIR} — the files are in ${PLAN}.d and the plan" >&2
        echo "beside them says which is which. Nothing is lost: the directory is" >&2
        echo "left in place, so the work can be put back by hand." >&2
        exit $rc
    fi
    rm -rf "$PLAN_DIR"
    exit $rc
}
trap restore_held_tree EXIT

python3 "$PLAN_DIR/staged-tree.py" hold --root "$ROOT" --plan "$PLAN" || {
    echo "pre-commit: the working tree could not be held at the index" >&2
    exit 1
}

echo "=== Pre-commit: linting the changed files ==="
python3 scripts/lint-changed.py || {
    echo "detekt (changed files) FAILED"
    exit 1
}

echo "=== Pre-commit: compiling the modules the change touches ==="
# The plan and the compile live in scripts/compile-changed.py: the module set
# is computed from the module graph, and the script says what it compiled and
# what it did not.
python3 scripts/compile-changed.py || {
    echo "compile-changed: FAILED"
    exit 1
}

echo "=== Pre-commit OK ==="
