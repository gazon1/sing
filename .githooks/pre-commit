#!/usr/bin/env bash
# Pre-commit hook: run checks via hk
#
# The steps are declared in hk.pkl: ktlint over the staged Kotlin files, then
# compile-changed compiles the modules the commit touches. `stash = "git"`
# holds unstaged changes aside while they run; untracked files are not held.
# The wrapper carries no selection logic: hk owns it, and this file only says
# which hook to run.

set -e

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

echo "=== Pre-commit: running checks via hk ==="

if ! command -v hk >/dev/null 2>&1; then
    echo "post-checkout: hk is required but not found. Run 'mise install'." >&2
    exit 0
fi

if ! command -v hk >/dev/null 2>&1; then
    echo "pre-commit: hk is required but not found (pinned in mise.toml)." >&2
    echo "Install it with: mise install" >&2
    echo "Or run this commit with: mise exec -- git commit ..." >&2
    exit 1
fi

hk run pre-commit

echo "=== Pre-commit OK ==="
