#!/usr/bin/env bash
# Pre-push hook: runs the full test suite before pushing.
#
# Runs on ALL branches (both main checkout and worktrees).
# This is the last gate before code leaves the local machine.
#
# Use `git push --no-verify` to skip this hook when needed (e.g., WIP commits).
#
# To bypass temporarily:
#   git push --no-verify
#
# To disable entirely (not recommended):
#   git config --unset core.hooksPath

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

BRANCH="$(git rev-parse --abbrev-ref HEAD)"

# ── Structural gates (seconds, no Gradle) ────────────────────────────────
#
# These run BEFORE the Gradle suite on purpose: they are pure file scans, so
# a structural violation is reported in under a second instead of after a
# multi-minute build. Same rationale as find-unwired-surfaces.py owning its
# own exit code — see docs/decisions/2026-10-01-test-infra-followups.md.

echo "=== Pre-push [$BRANCH] — structural gates ==="

if ! python3 scripts/build-version-catalog-gate.py --quiet .; then
    echo ""
    echo "pre-push FAILED — hardcoded version literal. Add it to gradle/libs.versions.toml"
    echo "and reference it via libs.*, or push with --no-verify."
    exit 1
fi

if ! bash Maestro/scripts/check-tags.sh; then
    echo ""
    echo "pre-push FAILED — unknown id: selector in a Maestro flow."
    echo "Add it to TestTags.kt or the legacy allow-list, or push with --no-verify."
    exit 1
fi

echo "=== Structural gates OK ==="
echo ""

# ── Worktree shortcut ──────────────────────────────────────────────────
# In a worktree, --git-dir (the actual .git dir for this worktree) differs
# from --git-common-dir (the shared .git dir for the main checkout).  In the
# main checkout they are the same.  Worktrees run their own cheap pre-push
# already; the full Gradle suite belongs only in the main checkout.
if [ "$(git rev-parse --git-dir)" != "$(git rev-parse --git-common-dir)" ]; then
    echo "=== Pre-push [$BRANCH] — worktree detected ==="
    echo "Run the full suite from the main checkout before merging."
    echo "Fast gates (build-version-catalog, Maestro tags) passed."
    exit 0
fi

echo "=== Pre-push [$BRANCH] — full test suite ==="

# Run all fast tests + detekt (slow tests are excluded — use CI for those).
# No -Ptest.tags here on purpose: JUnit's includeTags() excludes untagged
# tests, so `-Ptest.tags=fast` — which this hook used to pass — ran a single
# test file while the banner claimed "full test suite". The default
# (excludeTags("slow")) is what this comment always described.
# :desktopApp:detekt belongs here, not just in check.sh: a NoDirectClockSystem
# violation in TasksRobot reached main precisely because this hook only ran the
# shared module's detekt, and check.sh is not something every push goes through.
#
# --no-parallel, not the gradle.properties default (org.gradle.parallel=true).
# Parallel project execution runs :shared:jvmTest, :desktopApp:test and
# :mcp-server:test as concurrent builds against one checkout, and their forked
# test executors were observed dying mid-suite with EOFException — the client
# loses the stream to a "Gradle Test Executor" while another test task is
# compiling/replacing classes in the same build directory. Tests pass in
# isolation; only the parallel batch hits it (#471,
# docs/decisions/archive/2026-09-30-post-mr-2-findings.md). Serialising the
# three test tasks costs minutes on a push and buys a verdict that is about
# this code. The CLI flag is what makes it stick: --parallel is the default
# here, so omitting a flag is not the same as disabling it.
./gradlew :shared:detekt \
    :desktopApp:detekt \
    :shared:jvmTest \
    :desktopApp:test \
    :mcp-server:test \
    --no-daemon \
    --no-parallel || {
    echo ""
    echo "pre-push FAILED — push rejected. Fix failures or run with --no-verify"
    exit 1
}

echo "=== Pre-push OK ==="
