#!/usr/bin/env bash
# Pre-push hook: fast gates + the detekt verdict (read-only).
#
# The full Gradle test suite runs in CI, not here. Pre-push must be fast enough
# to run on every push without making people reach for --no-verify.
#
# What runs here vs. in CI:
#   Here:    structural gates (seconds) + the detekt verdict over the modules
#            the change can reach (a minute for a narrow change; ~9 min for a
#            change in `shared`, measured 2026-10-23 — the price is published
#            in docs/testing/gate-costs.md)
#   CI:      full suite — jvmTest, desktopApp:test, mcp-server:test,
#            kover, static-gates, Maestro flows
#
# WHAT IS CHECKED: the tree that is being pushed, not the checked-out worktree.
#
# WHAT IS NOT: the modules the change does not reach. The local verdict is
# partial — CI judges the modules its own list names, and that list is
# hand-written, not read from the build: a module the graph knows and CI's
# list does not name is judged here and by nobody else. The difference is
# written down in config/hooks/pre-push.json, and scripts/check-hook-gates.py
# keeps that record and this hook in step.
#
# `git push` hands the hook the refs it is about to write:
#     <local ref> <local sha> <remote ref> <remote sha>
# The local sha is the tree the remote will end up holding. The worktree is a
# different thing: `git push origin HEAD:other-branch` and a force-push of a
# rebuilt branch both push a tree the worktree does not hold, and a hook that
# gates the worktree reports green for a tree nobody pushed — and red for a
# tree that is fine. So every pushed local ref is checked out into a throwaway
# detached worktree, the structural gates run there, and the worktree is
# removed again.
#
# The detekt verdict is taken about the pushed tree as well. It is the only
# step that can run in the current worktree, and only when that worktree holds
# byte-identical content for everything detekt reads — then the worktree IS
# the pushed tree, and judging it there is warm: the Gradle daemon and the
# build directories are the ones this checkout has been using. When the
# worktree holds something else, the verdict is taken in a throwaway worktree
# at the pushed sha: a violation that is only in the worktree is then not
# reported as a violation of the tree being pushed, and a violation that IS in
# the pushed tree is not missed because the worktree happens to be clean.
#
# THE GIT ENVIRONMENT INSIDE THE TREE BEING PUSHED
#
# Git hands a hook the environment it runs in, and the one that matters is
# GIT_DIR: it points at the worktree the push was made from. In a linked
# worktree that is literal — GIT_DIR is that worktree's own git dir — and
# GIT_WORK_TREE and GIT_INDEX_FILE can come from the developer's shell as
# well.
#
# So every command that runs INSIDE the tree being pushed has to drop that
# environment before it runs. Without the drop, git reads the original
# worktree's index there and reports about a tree nobody pushed: a test that
# shells out to git fails with "git add: exit status 128", the gate suite
# fails for a reason that has nothing to do with the code, and the diff that
# shows what detekt corrected is taken against the wrong base. The tree being
# pushed has its own `.git` file, and git finds it when the environment does
# not say otherwise.
#
# Every step of this hook that runs in the tree being pushed therefore starts
# with `without_hook_git_env` — the helper in `scripts/git-env.sh`, which reads
# the names from `scripts/src/sgate/gatekit/gitenv.py`, where the list of them
# lives, so the hook, the gates and the tests cannot disagree about it. The
# script the hook calls — `scripts/pre-push-verdict.py` — runs its own git
# commands through the same answer: `tree_env()` from that module. A command
# added inside that tree has to do the same: the contract is not enforced, it
# is written down, and the next command that forgets it breaks silently, on a
# tree that was fine.
#
# The gates this hook runs are declared once, in
# `scripts/src/sgate/gatekit/pre_push.py`, and read from there: the hook names
# no gate, so a gate added to the declaration is a gate the hook runs and a
# gate the fixture that drives this hook stubs. A declaration that cannot be
# read fails the push — a hook that ran no gate and said OK would turn "not
# checked" into "checked and green".
#
# Runs on ALL branches (both main checkout and worktrees).
# Use `git push --no-verify` to skip this hook when needed (e.g., WIP commits).
# To disable entirely: git config --unset core.hooksPath

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

CURRENT_BRANCH="$(git rev-parse --abbrev-ref HEAD)"
ZERO_SHA="0000000000000000000000000000000000000000"

# The git environment a hook exports, dropped once.
#
# The helper lives in scripts/git-env.sh, and it reads the list of names from
# the module that owns them — scripts/src/sgate/gatekit/gitenv.py — so the
# hook, the gates and the tests cannot disagree about it. The helper carries no
# copy of the list.
#
# A push that cannot read the answer does not push. Every step below runs
# inside the tree being pushed, and a step that inherits the environment of the
# worktree the push was made from reads the wrong tree — a `git config` in a
# test's temporary repository writes into the repository the hook runs in, and
# this checkout is shared by ~20 worktrees.
if [ ! -f "$REPO_ROOT/scripts/git-env.sh" ]; then
    echo ""
    echo "pre-push FAILED — scripts/git-env.sh is missing, and every step below runs in"
    echo "the tree being pushed with the git environment this hook inherited."
    exit 1
fi
# shellcheck source=scripts/git-env.sh
. "$REPO_ROOT/scripts/git-env.sh"
if [ -z "${GATEKIT_GIT_UNSET_ARGS:-}" ]; then
    echo ""
    echo "pre-push FAILED — the list of git variables a hook exports could not be read"
    echo "from scripts/src/sgate/gatekit/gitenv.py, and every step below runs in the tree being pushed."
    echo "Run: python3 scripts/src/sgate/gatekit/gitenv.py --shell-unset-args"
    exit 1
fi

# Git passes the remote it pushes to as the first argument, and that remote's
# url as the second. The remote is named `origin` by convention and by most
# clones, but nothing guarantees it: `git push fork main` pushes to `fork`, and
# a question about `origin` would then be about another repository. The step
# that prints the CI verdict below asks about the remote that receives the
# push, so it needs the name.
PUSH_REMOTE_NAME="${1:-origin}"

# ── The push description (stdin) ──────────────────────────────────────────
#
# One line per ref. It is read ONCE, here, and everything below works from
# the parsed values: a second read would find an empty stdin and silently
# validate nothing.
#
#   local sha all zeros  → the remote ref is being DELETED. No tree is pushed,
#                          so there is nothing to validate.
#   remote sha all zeros → the remote ref is new.
PUSH_REFS=()
PUSH_LOCAL_SHAS=()
PUSH_REMOTE_REFS=()
PUSH_REMOTE_SHAS=()
# The tree each pushed ref was checked out into — the empty string for a ref
# that was skipped (a deletion, a ref that is already up to date) or whose
# worktree could not be created.
REF_TREES=()
while read -r local_ref local_sha remote_ref remote_sha; do
    [ -n "${local_sha:-}" ] || continue
    PUSH_REFS+=("$local_ref")
    PUSH_LOCAL_SHAS+=("$local_sha")
    PUSH_REMOTE_REFS+=("${remote_ref:-}")
    PUSH_REMOTE_SHAS+=("${remote_sha:-}")
done

# ── Throwaway worktree management ─────────────────────────────────────────
#
# The tree being pushed is checked out in a detached worktree under a temp
# directory. It is removed on every exit path (trap), and the git metadata is
# pruned, so `git worktree list` does not accumulate entries.
TMP_ROOT=""
TEMP_WORKTREES=()

cleanup() {
    local rc=$?
    for t in ${TEMP_WORKTREES[@]+"${TEMP_WORKTREES[@]}"}; do
        git worktree remove --force "$t" >/dev/null 2>&1 || rm -rf "$t"
    done
    git worktree prune >/dev/null 2>&1 || true
    if [ -n "$TMP_ROOT" ]; then
        rm -rf "$TMP_ROOT"
    fi
    # 141 is SIGPIPE: a pipeline in this hook was closed before it finished
    # writing, and under `pipefail` the pipeline reports it. It is not a gate
    # verdict — the gates print their own — so it is named here rather than left
    # to be read as "the pre-push hook declined the push".
    if [ "$rc" = "141" ]; then
        echo "" >&2
        echo "pre-push: exited with 141 (SIGPIPE) — a pipeline here was closed early." >&2
        echo "This is a broken pipe, not a gate failure. If the push itself failed" >&2
        echo "with 141 and no output above, the cause is the transport (SSH), not this hook." >&2
    fi
    exit $rc
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

new_temp_root() {
    if [ -z "$TMP_ROOT" ]; then
        TMP_ROOT="$(mktemp -d "${TMPDIR:-/tmp}/pre-push-gate-XXXXXX")"
        # An empty hooks dir: `git worktree add` fires the post-checkout hook,
        # which would regenerate DIGEST.md inside the throwaway tree. The tree
        # under validation must be the tree that is being pushed, unchanged.
        mkdir -p "$TMP_ROOT/hooks"
        # The owning pid, so a later run can tell a dead run's leftovers from
        # a live run's worktree.
        echo "$$" > "$TMP_ROOT/pid"
    fi
}

# A hook that was SIGKILLed cannot run its trap, and a killed hook leaves its
# throwaway worktree registered in this repository's metadata. Left alone, those
# entries accumulate in `git worktree list` and in `.git/worktrees/`.
#
# So each run reaps the leftovers of DEAD runs before it starts. A temp worktree
# whose owning pid is still alive belongs to a concurrent push — it is left
# alone: removing it would pull the ground from under that push.
reap_stale_temp_worktrees() {
    local tree_path root pid
    while read -r tree_path; do
        root="$(dirname "$tree_path")"
        pid="$(cat "$root/pid" 2>/dev/null || true)"
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            continue
        fi
        echo "pre-push: removing a stale temporary worktree from a killed run ($tree_path)"
        git worktree remove --force "$tree_path" >/dev/null 2>&1 || rm -rf "$tree_path"
        rm -rf "$root"
    done < <(git worktree list --porcelain | sed -n 's/^worktree //p' | grep -E '/pre-push-gate-' || true)
    git worktree prune >/dev/null 2>&1 || true
}

reap_stale_temp_worktrees

# ── Holding the tree that is being pushed ───────────────────────────────
#
# A throwaway worktree per pushed tree, registered in TEMP_WORKTREES so the
# trap removes it on every exit path.
#
# The result is returned in CHECKOUT_TREE rather than on stdout: the caller
# prints the path itself, and a function that mixes a value and a message on
# one stream makes the caller guess which is which.
#
# The slot names the directory: a path that is already a registered worktree
# is refused by `git worktree add`, and a second ref must not inherit the
# first ref's tree.
CHECKOUT_TREE=""

checkout_pushed_tree() {
    local sha="$1" slot="$2" resolved candidate
    CHECKOUT_TREE=""
    resolved="$(git rev-parse --verify --quiet "${sha}^{commit}" 2>/dev/null || true)"
    if [ -z "$resolved" ]; then
        echo "   !!! $sha does not resolve to a commit in this repository"
        return 1
    fi
    new_temp_root
    candidate="$TMP_ROOT/tree-$slot"
    if git -c core.hooksPath="$TMP_ROOT/hooks" worktree add --detach --quiet \
        "$candidate" "$resolved" >"$TMP_ROOT/worktree-add.log" 2>&1; then
        TEMP_WORKTREES+=("$candidate")
        CHECKOUT_TREE="$candidate"
        return 0
    fi
    echo "   !!! could not create a temporary worktree for ${resolved:0:8}:"
    sed 's/^/       /' "$TMP_ROOT/worktree-add.log" || true
    return 1
}

# The worktree that holds a pushed sha, if one was already checked out.
tree_for_sha() {
    local sha="$1" j
    for j in "${!PUSH_REFS[@]}"; do
        if [ "${PUSH_LOCAL_SHAS[$j]}" = "$sha" ] && [ -n "${REF_TREES[$j]:-}" ]; then
            printf '%s' "${REF_TREES[$j]}"
            return 0
        fi
    done
    return 1
}

# The names of the tests that failed, from the suite's own output.
#
# `unittest` prints one line per failure — "FAIL: test_x" — and this hook used
# to throw the whole output away, so a red push said only that the suite did
# not pass. The names are the beginning of the answer, and the answer is what
# the person pushing needs.
report_failed_tests() {
    local log="$1" names
    [ -f "$log" ] || return 0
    # `|| true`: the hook runs with `set -euo pipefail`, and a log without a
    # failing test is a log whose grep found nothing.
    names="$(grep -E '^(FAIL|ERROR): ' "$log" | head -20 || true)"
    if [ -n "$names" ]; then
        echo "   the failing tests:"
        printf '%s\n' "$names" | sed 's/^/     /'
    fi
}

# The suite's log, kept past the push.
#
# The temp root is removed when the hook exits, so a path printed inside it is
# a path that is gone by the time the reader reads the line. The log is copied
# into the checkout's `build/diagnostics/` — where this repository keeps what
# a run leaves behind — and the copy is what the message names.
keep_suite_log() {
    local source="$1" kept="$2"
    [ -f "$source" ] || return 0
    mkdir -p "$(dirname "$kept")" 2>/dev/null || return 0
    cp "$source" "$kept" 2>/dev/null || return 0
    # The temporary copy has served its purpose: the kept one outlives the
    # push, and the temporary directory is not the place to leave it.
    rm -f "$source" 2>/dev/null || true
    echo "   the whole log is at $kept"
}

# ── Structural gates (seconds, no Gradle) ────────────────────────────────
#
# Both gates run against the TREE THAT IS BEING PUSHED. The gate scripts are
# the ones from this checkout — the checker is the current one, the way CI
# runs it — and they are pointed at the pushed tree.

GATES_FAILED=0

echo "=== Pre-push — structural gates (against the pushed tree) ==="

if [ "${#PUSH_REFS[@]}" -eq 0 ]; then
    echo "no refs in this push — nothing to validate"
fi

for i in "${!PUSH_REFS[@]}"; do
    local_ref="${PUSH_REFS[$i]}"
    local_sha="${PUSH_LOCAL_SHAS[$i]}"
    remote_ref="${PUSH_REMOTE_REFS[$i]}"
    remote_sha="${PUSH_REMOTE_SHAS[$i]}"

    if [ "$local_sha" = "$ZERO_SHA" ]; then
        echo ""
        echo "→ $local_ref → $remote_ref — deletion: no tree is pushed, skipped"
        continue
    fi

    if [ -n "$remote_sha" ] && [ "$local_sha" = "$remote_sha" ]; then
        echo ""
        echo "→ $local_ref → $remote_ref — already up to date, skipped"
        continue
    fi

    echo ""
    echo "→ $local_ref → $remote_ref @ $local_sha"

    tree=""
    if checkout_pushed_tree "$local_sha" "$i"; then
        tree="$CHECKOUT_TREE"
        echo "   pushed tree checked out in a temporary worktree (detached at ${local_sha:0:8})"
    fi
    REF_TREES[$i]="$tree"

    if [ -z "$tree" ]; then
        echo "   !!! FALLBACK — validating the CURRENT WORKTREE ($CURRENT_BRANCH) instead."
        echo "   !!! That is NOT the tree being pushed: this check does not cover the pushed content."
        tree="$REPO_ROOT"
    fi

    # ── The promise files ─────────────────────────────────────────────────
    #
    # Some files in this repository promise something about the code next to
    # them, and each promise has been broken at least once — always in CI,
    # always hours later, always on somebody else's tree:
    #
    #   Maestro/TAGS.md                — the catalogue of the ids a flow may
    #                                     address, generated from TestTags.kt
    #   config/docs/maestro-flows.txt  — the catalogue of the flows themselves
    #   .specify/issues/*.yaml         — the registry of every openspec change
    #
    # A checker for each of them exists and costs seconds. What was missing was
    # the moment: the promise is kept when the file next to it changes, not
    # when CI eventually notices.
    #
    # So the check runs here, against the tree that is being pushed, and only
    # when that tree actually touches the file that carries the promise — a
    # push that touches nothing relevant pays nothing.
    #
    # The checkers are run FROM the pushed tree (`$tree/scripts/...`), because
    # each derives its repository root from its own file location: the copy in
    # the tree is the copy that knows about the tree.
    #
    # The checks themselves are declared in the registry, like every other
    # gate; what is here is what the push touched, which is what decides
    # whether a check runs at all.
    if [ -n "$remote_sha" ] && [ "$remote_sha" != "$ZERO_SHA" ]; then
        PROMISE_RANGE=("$remote_sha..$local_sha")
    else
        PROMISE_RANGE=("$local_sha" --not --remotes)
    fi
    # The files the pushed commits touch. `git log --name-only` rather than
    # `git diff`: the range is the pushed commits, and a file that a commit
    # touched is a file this push carries.
    PROMISE_TOUCHED="$(git log --name-only --pretty=format: "${PROMISE_RANGE[@]}" 2>/dev/null || true)"

    # promise_touched <path> — did this push touch that path?
    #
    # `grep -c` and not `grep -q`: `-q` closes the pipe on the first hit, the
    # writer takes SIGPIPE, and with `pipefail` the pipeline reports 141 —
    # which is a broken pipe, not an answer.
    promise_touched() {
        printf '%s\n' "$PROMISE_TOUCHED" | grep -c "^$1" >/dev/null
    }

    # The output of a promise check, kept for the failure message.
    #
    # The checkers import the gate CLI, whose logger writes a DEBUG line per
    # loaded module — noise that would bury the finding in a hook that people
    # read when they are trying to push. The output is captured instead of
    # streamed, and shown (without the DEBUG lines) only when the check fails.
    PROMISE_OUT="$(mktemp "${TMPDIR:-/tmp}/pre-push-promise-XXXXXX")"

    # Every gate below runs with the exported GIT_* variables removed.
    #
    # Git exports GIT_DIR (and GIT_WORK_TREE, GIT_INDEX_FILE) to a hook, and a
    # hook runs gates, tests and scripts that call git in ANOTHER tree. Without
    # the removal, a `git config` in a test's temporary repository writes into
    # the repository the hook runs in — and this checkout is shared by ~20
    # worktrees, so the damage lands in the shared config: a replaced
    # core.sshCommand, a lost core.hooksPath, a rewritten remote. Measured on
    # 2026-10-23: one run of the test suite wrote four such values.
    #
    # GIT_OBJECT_DIRECTORY and GIT_QUARANTINE_PATH are deliberately NOT
    # removed: they hold the objects of the commits being pushed, and the
    # verdict below has to see them.

    # ── The gates ──────────────────────────────────────────────────────────
    #
    # The steps come from the registry, so the hook does not name a script: a
    # gate added to the registry is a gate the hook runs, and a gate removed
    # from the registry is a gate the hook does not run.
    #
    # The hook used to carry a block per gate — the script, its arguments, the
    # condition under which it runs, and the message it prints when it fails
    # — and every one of those blocks was a second copy of the declaration the
    # test fixture reads. The blocks are the registry's now.
    #
    # The table is read once, before the loop, and a table that cannot be read
    # fails the push: a hook that ran no gate and said OK turned "not checked"
    # into "checked and green".
    #
    # The declaration is read by path, not imported: the tree being pushed
    # carries the file, and a tree that carries it does not carry the rest of
    # the gate package. The path is part of the declaration, and the gate
    # that compares the hook with the registry checks that the two agree.
    PRE_PUSH_STEPS_TABLE="$(cd "$REPO_ROOT" && \
        python3 "$REPO_ROOT/scripts/src/sgate/gatekit/pre_push.py" --table 2>/dev/null || echo '')"
    if [ -z "$PRE_PUSH_STEPS_TABLE" ]; then
        echo "   gates: FAILED (the registry did not yield the list of gates)"
        GATES_FAILED=1
        echo ""
        echo "pre-push FAILED — the list of gates the hook runs could not be read from the registry."
        echo "Run python3 scripts/check-hook-gates.py to see whether the registry is readable, or push with --no-verify."
    else
        while IFS='|' read -r step_label step_script step_args step_script_from \
            step_pythonpath_from step_when step_show_output step_message step_hint; do
            [ -n "$step_label" ] || continue

            # Which copy of the script runs, and which copy of the gate CLI is
            # on its path. A gate that reads a tree runs the copy that knows
            # about the tree.
            if [ "$step_script_from" = "repo" ]; then
                step_path="$REPO_ROOT/$step_script"
            else
                step_path="$tree/$step_script"
            fi
            step_env=()
            case "$step_pythonpath_from" in
                repo) step_env+=("PYTHONPATH=$REPO_ROOT/scripts/src") ;;
                tree) step_env+=("PYTHONPATH=$tree/scripts/src") ;;
            esac

            # When the step runs at all.
            step_note=""
            case "$step_when" in
                always) ;;
                if-dir:*)
                    if [ ! -d "$tree/${step_when#if-dir:}" ]; then
                        step_note="this tree has no ${step_when#if-dir:}"
                    fi
                    ;;
                if-import:*)
                    if ! python3 -c "import ${step_when#if-import:}" >/dev/null 2>&1; then
                        step_note="${step_when#if-import:} is not installed"
                    fi
                    ;;
                if-script)
                    if [ ! -f "$step_path" ]; then
                        step_note="the pushed tree does not have this rule"
                    fi
                    ;;
                if-touched:*)
                    step_touched=0
                    IFS=',' read -r -a step_patterns <<< "${step_when#if-touched:}"
                    for step_pattern in "${step_patterns[@]}"; do
                        if promise_touched "$step_pattern"; then
                            step_touched=1
                            break
                        fi
                    done
                    if [ "$step_touched" = "0" ]; then
                        continue
                    fi
                    ;;
            esac
            if [ -n "$step_note" ]; then
                echo "   $step_label: SKIPPED ($step_note)"
                continue
            fi

            # The arguments, and the message the hook prints when the gate
            # fails.
            step_argv=()
            for step_arg in $step_args; do
                step_argv+=("${step_arg//@TREE@/$tree}")
            done
            step_message="${step_message//@REF@/$local_ref}"
            step_message="${step_message//@TREE@/$tree}"
            step_hint="${step_hint//@REF@/$local_ref}"
            step_hint="${step_hint//@TREE@/$tree}"

            if [ "$step_show_output" = "yes" ]; then
                # The output is captured and shown only when the gate fails:
                # the gate CLI writes a DEBUG line per loaded module, and a
                # hook that people read while they are trying to push should
                # not bury the finding in it.
                if (cd "$tree" && without_hook_git_env \
                    ${step_env[@]+"${step_env[@]}"} python3 "$step_path" ${step_argv[@]+"${step_argv[@]}"}) \
                    >"$PROMISE_OUT" 2>&1; then
                    echo "   $step_label: OK"
                else
                    echo "   $step_label: FAILED"
                    GATES_FAILED=1
                    echo ""
                    echo "$step_message"
                    sed '/DEBUG/d' "$PROMISE_OUT" | sed 's/^/   /'
                    echo "$step_hint"
                fi
            else
                if (cd "$tree" && without_hook_git_env \
                    ${step_env[@]+"${step_env[@]}"} python3 "$step_path" ${step_argv[@]+"${step_argv[@]}"}); then
                    echo "   $step_label: OK"
                else
                    echo "   $step_label: FAILED"
                    GATES_FAILED=1
                    echo ""
                    echo "$step_message"
                    echo "$step_hint"
                fi
            fi
        done <<EOF
$PRE_PUSH_STEPS_TABLE
EOF
    fi
    rm -f "$PROMISE_OUT"

    # ── The gate suite's own tests ───────────────────────────────────────
    #
    # The test that caught a wrong timeout in the CI workflow lived in CI and
    # nowhere else: the local shield did not run it, so the mistake cost 33
    # minutes of CI instead of two and a half of local work. These tests are
    # what says the gates can fail — a gate suite nobody has run is a gate
    # suite that is green by accident.
    #
    # They run against the tree being pushed, like every other gate here: the
    # CI job that runs them runs the pushed tree's copies.
    #
    # Git exports GIT_DIR (and GIT_WORK_TREE, GIT_INDEX_FILE, GIT_COMMON_DIR)
    # for the hook it runs. A test that creates a repository of its own
    # inherits those, and `git init` then reinitialises THIS repository
    # instead of the test's: `git add -A` stages the test's directory against
    # this repository's index — every tracked file looks deleted — and
    # `git commit` writes the test's tree onto the branch being pushed. That
    # happened on 2026-10-23: a fixture committed a 12124-file deletion into
    # the working repository, and the same tree reached the remote main.
    #
    # So the suite runs without those names. The fixtures also scrub them
    # themselves (scripts/tests/git_sandbox.py), because the suite is run
    # outside a hook too, and this line is the belt to their braces.
    # The suite runs inside a hook, so the marker is set.
    #
    # One of the suite's own tests drives the hook through a real push, and the
    # hook runs the suite — so a suite that runs inside a hook runs itself: the
    # hook's step pushes, the push runs the hook, the hook runs the suite, and
    # the suite pushes again. On 2026-10-23 that recursion is what made this
    # step fail: the probe test asserted that the probe had run, and the probe
    # ran one tree deeper than the assertion was about. The test skips itself
    # when the marker is set, and it runs everywhere else — in CI, and by
    # anybody who runs the suite by hand.
    #
    # The suite's output goes to a file, and the failing test names are
    # printed: a step that says "FAILED" without saying which test failed
    # costs the reader the whole push.
    # The log lives in a file of its own, not in the hook's temp root: the
    # temp root is created only when a pushed sha is checked out, and a push
    # of a sha that does not resolve falls back to the worktree with no temp
    # root at all — a log path built from it was `/gate-suite-0.log`, and the
    # hook failed on the *log*, not on the suite.
    suite_log="$(mktemp "${TMPDIR:-/tmp}/pre-push-gate-suite-XXXXXX.log")"
    suite_log_kept="$REPO_ROOT/build/diagnostics/pre-push-gate-suite-$(date +%Y%m%d-%H%M%S)-$i.log"
    if [ ! -d "$tree/scripts/tests" ]; then
        echo "   gate suite tests: SKIPPED (the pushed tree does not have them)"
    elif [ ! -f "$tree/scripts/run-gate-tests.py" ]; then
        # A tree that predates the runner has no runner. The plain `unittest`
        # runs the same tests — and a push of an old branch is not blocked by
        # a file that branch does not have.
        if (cd "$tree" && without_hook_git_env \
            GATE_SUITE_INSIDE_HOOK=1 \
            PYTHONPATH="$tree/scripts/src" \
            python3 -m unittest discover -s scripts/tests >"$suite_log" 2>&1); then
            echo "   gate suite tests: OK (the tree has no runner — plain unittest)"
            rm -f "$suite_log"
        else
            echo "   gate suite tests: FAILED"
            GATES_FAILED=1
            report_failed_tests "$suite_log"
            keep_suite_log "$suite_log" "$suite_log_kept"
            echo ""
            echo "pre-push FAILED — the gate suite's own tests do not pass in the tree of $local_ref."
        fi
    elif (cd "$tree" && without_hook_git_env \
        GATE_SUITE_INSIDE_HOOK=1 \
        PYTHONPATH="$tree/scripts/src" \
        python3 "$tree/scripts/run-gate-tests.py" >"$suite_log" 2>&1); then
        echo "   gate suite tests: OK"
        rm -f "$suite_log"
    else
        echo "   gate suite tests: FAILED"
        GATES_FAILED=1
        report_failed_tests "$suite_log"
        echo ""
        echo "pre-push FAILED — the gate suite's own tests do not pass in the tree of $local_ref."
        keep_suite_log "$suite_log" "$suite_log_kept"
    fi


done

if [ "$GATES_FAILED" = "1" ]; then
    echo ""
    echo "=== Pre-push FAILED — structural gates ==="
    exit 1
fi

echo ""
echo "=== Structural gates OK (against the pushed tree; a rule the pushed tree"
echo "    does not have is skipped, not checked) ==="
echo ""

# ── detekt verdict (about the tree that is being pushed) ────────────────
#
# The decision — which tree to judge, and whether the tree changed under
# detekt's feet — lives in scripts/pre-push-verdict.py, where it is
# unit-tested. It used to be bash here, with two branches nothing exercised.
#
# What the verdict means, in one paragraph: the tree that is being pushed is
# judged, not the worktree. The current worktree is judged when it holds
# byte-identical content for everything detekt can read — then it IS the
# pushed tree, and judging it there is warm (this checkout's own Gradle home
# and build directories). Otherwise a tree that holds the pushed content is
# judged, so a violation that is only in the worktree is not reported against
# a tree nobody pushed, and a violation that is in the pushed tree is not
# missed because the worktree happens to be clean.
#
# Two signals make the verdict red, and both are needed: the run's exit code
# (the findings detekt reported) and the content digest before and after the
# run (the evidence that the run changed the tree it was judging).
#
# The verdict READS the tree; it does not correct it (ADR
# 2026-10-23-the-verdict-reads-the-tree-it-does-not-correct-it.md). The
# correction is a separate step — `just detekt-fix` — and the verdict names the
# findings instead of quietly repairing the tree that is about to be pushed.
#
# All the judged modules cost ONE Gradle invocation: the configuration phase is
# paid once, not once per module. (One invocation per module was needed while
# the verdict corrected: `--auto-correct` reaches only the last task of an
# invocation — ADR 2026-10-17.)
#
# `--rerun` forces re-analysis: without it Gradle is UP-TO-DATE and the verdict
# would be about the previous run's inputs. `--rerun` re-runs detekt alone and
# leaves its dependencies alone.
#
# `--rerun-tasks` was the flag here until 2026-10-20, and it is the reason the
# hook cost 8-10 minutes instead of the two the comment above it claims:
# `--rerun-tasks` re-runs the WHOLE task graph of the invocation, so every
# Kotlin compilation of `:shared` and `:desktopApp` was re-done from scratch on
# every push, only for detekt to re-analyse the sources that were compiled
# anyway. `--rerun` re-runs detekt alone.

echo "=== Pre-push [$CURRENT_BRANCH] — detekt verdict (about the pushed tree) ==="

DETEKT_FAILED=0
# How many trees were actually judged: a verdict that was not taken is not a
# clean verdict, and the summary must not claim otherwise.
DETEKT_JUDGED=0
# How many trees had nothing to judge. Nothing was checked there, so nothing
# was found: that is "not taken", not "clean".
#
# There are TWO reasons for that, and they are different claims: a change that
# moves neither Kotlin nor rules, and a change that moves Kotlin into a module
# whose verdict is its test suite. The verdict script knows which one it was
# and says so in its own words; the reasons are collected here and repeated
# below, because a hook that substitutes its own reason tells the reader that
# a change which moves Kotlin moves no Kotlin.
DETEKT_NOTHING=0
# The verdict's own reasons, in its own words, separated by "; ".
NOTHING_REASONS=""
# The modules the verdict judged, in the module graph's names.
JUDGED_MODULES=""
judged_shas=" "

# The modules the verdict judged, in the module graph's names.
#
# The verdict prints the Gradle tasks it ran; the module of a task is the task
# without its leading colon and without its detekt suffix. This list is only
# used to compare with CI's list — the hook never decides what to judge, the
# verdict script does, from the module graph.
collect_judged_modules() {
    local out="$1" tasks task module
    tasks="$(printf '%s\n' "$out" | sed -n 's/^ *modules judged: //p' | head -1)"
    for task in ${tasks//,/ }; do
        module="${task#:}"
        module="${module%:detekt}"
        [ -n "$module" ] || continue
        case " $JUDGED_MODULES " in
            *" $module "*) continue ;;
        esac
        JUDGED_MODULES="${JUDGED_MODULES:+$JUDGED_MODULES }$module"
    done
}

# The asymmetry between this hook and CI, made visible.
#
# CI judges a HAND-WRITTEN list of modules — the detekt tasks named in the CI
# workflow — and this hook judges the modules the change reaches, computed
# from the module graph. A module the graph knows and CI's list does not name
# is judged here and by nobody else, so it is named out loud instead of being
# left silent.
report_coverage_gap() {
    local ci_file="$REPO_ROOT/.github/workflows/ci.yml"
    local ci_modules module gap=""
    [ -r "$ci_file" ] || return 0
    ci_modules="$(grep -oE ':[[:alnum:]_-]+:detekt' "$ci_file" \
        | sed 's/:detekt$//' | sed 's/^://' | sort -u || true)"
    [ -n "$ci_modules" ] || return 0
    for module in $JUDGED_MODULES; do
        if ! printf '%s\n' "$ci_modules" | grep -qxF "$module"; then
            gap="${gap:+$gap, }$module"
        fi
    done
    if [ -n "$gap" ]; then
        echo "detekt coverage: judged here but not named by CI: $gap"
        echo "               CI's detekt list is hand-written — a module the graph knows can be missing from it"
    fi
}

for i in "${!PUSH_REFS[@]}"; do
    local_ref="${PUSH_REFS[$i]}"
    local_sha="${PUSH_LOCAL_SHAS[$i]}"
    remote_ref="${PUSH_REMOTE_REFS[$i]}"
    remote_sha="${PUSH_REMOTE_SHAS[$i]}"

    if [ "$local_sha" = "$ZERO_SHA" ]; then
        continue                          # a deletion pushes no tree
    fi
    if [ -n "$remote_sha" ] && [ "$local_sha" = "$remote_sha" ]; then
        continue                          # already up to date: nothing is pushed
    fi
    case "$judged_shas" in
        *" $local_sha "*) continue ;;    # the same tree, judged once
    esac
    judged_shas="$judged_shas $local_sha "

    # Does this push carry Kotlin at all? Only the pushed commits count: the
    # verdict is about the pushed tree, and a Kotlin file that is only in the
    # worktree is not in it.
    #
    # The modules to judge are computed by scripts/pre-push-verdict.py from the
    # module graph: a change in one module judges that module and the ones
    # that compile against it, a change in the rules or in the build judges
    # every module, and a change that moves neither Kotlin nor rules needs no
    # detekt run at all. So the question "does this push carry Kotlin?" is
    # answered there, by the same code that decides what to judge — not here,
    # by a second rule that can disagree with it.
    echo ""
    echo "→ $local_ref → $remote_ref @ $local_sha"

    # The worktree this hook already checked out for this sha, if any: the
    # verdict falls back to it when the current worktree holds something else.
    fallback=""
    if [ -n "${REF_TREES[$i]:-}" ]; then
        fallback="${REF_TREES[$i]}"
    fi

    # The base of the pushed range: the tree the remote already holds. It is
    # what the change is measured against. A branch the remote does not have
    # yet is measured against its own upstream, and only then against the
    # trunk (the script's default) — so a branch that targets a release line
    # is not measured against `main`.
    base=""
    if [ -n "$remote_sha" ] && [ "$remote_sha" != "$ZERO_SHA" ]; then
        base="$remote_sha"
    fi
    local_branch="${local_ref#refs/heads/}"

    new_temp_root
    verdict_rc=0
    verdict_out=""
    if [ -n "$base" ]; then
        verdict_out="$(python3 "$REPO_ROOT/scripts/pre-push-verdict.py" \
            --sha "$local_sha" \
            --repo "$REPO_ROOT" \
            --fallback-tree "$fallback" \
            --base "$base" \
            --branch "$local_branch" \
            --log-dir "$TMP_ROOT/verdict")" || verdict_rc=$?
    else
        verdict_out="$(python3 "$REPO_ROOT/scripts/pre-push-verdict.py" \
            --sha "$local_sha" \
            --repo "$REPO_ROOT" \
            --fallback-tree "$fallback" \
            --branch "$local_branch" \
            --log-dir "$TMP_ROOT/verdict")" || verdict_rc=$?
    fi
    printf '%s\n' "$verdict_out"

    # A verdict that found nothing to judge is not a verdict: nothing was
    # checked, so nothing was found. The summary says "not taken" rather than
    # "clean", because a clean tree is a claim and this is not one.
    #
    # The reason is the verdict's own: it prints it, and the hook repeats it
    # instead of inventing one. The two reasons are different claims — a change
    # that moves no Kotlin at all, and a change that moves Kotlin into a module
    # that has no detekt task of its own — and the hook must not tell the
    # reader that the second is the first.
    case "$verdict_out" in
        *"nothing to judge"*)
            DETEKT_NOTHING=$((DETEKT_NOTHING + 1))
            verdict_line="$(printf '%s\n' "$verdict_out" | grep -m1 'nothing to judge' || true)"
            verdict_reason="${verdict_line#*nothing to judge}"
            # The reason follows the verdict script's own separator; strip
            # whatever leads it (spaces, a dash) without naming the dash, so a
            # different dash does not cost the reason.
            verdict_reason="$(printf '%s' "$verdict_reason" | sed 's/^[^[:alnum:]]*//')"
            if [ -n "$verdict_reason" ]; then
                NOTHING_REASONS="${NOTHING_REASONS:+$NOTHING_REASONS; }$verdict_reason"
            fi
            ;;
        *)
            DETEKT_JUDGED=$((DETEKT_JUDGED + 1))
            collect_judged_modules "$verdict_out"
            ;;
    esac

    if [ "$verdict_rc" = "0" ]; then
        continue
    fi

    DETEKT_FAILED=1
    if [ "$verdict_rc" = "2" ]; then
        echo ""
        echo "pre-push FAILED — the detekt verdict could not be taken for $local_ref."
        echo "The tree that is being pushed was not judged, so this push is not certified."
        continue
    fi

    echo ""
    echo "pre-push FAILED — detekt reported findings in the tree that is being pushed ($local_ref)."
    echo "Fix them and push again: 'just detekt-fix' applies the corrections, then amend and push"
    echo "(or push with --no-verify)."
done

if [ "$DETEKT_FAILED" = "1" ]; then
    echo ""
    echo "=== Pre-push FAILED — detekt verdict ==="
    exit 1
fi

echo ""
if [ "$DETEKT_JUDGED" = "0" ] && [ "$DETEKT_NOTHING" = "0" ]; then
    echo "detekt verdict: not taken — nothing was pushed to judge"
elif [ "$DETEKT_JUDGED" = "0" ]; then
    # The verdict's own reason, in the verdict script's own words: a change
    # that moves no Kotlin and a change that moves Kotlin into a module with no
    # detekt task are different claims, and the hook does not get to pick one.
    echo "detekt verdict: not taken — ${NOTHING_REASONS:-the verdict script did not say why it took none}"
else
    echo "detekt verdict: the pushed tree is clean for the modules the change can affect"
    echo "detekt coverage: CI judges the modules its own list names (that list is hand-written); the hook judges the ones this change reaches"
    report_coverage_gap
fi
echo ""


# ── The CI verdict of what is being pushed ───────────────────────────────
#
# One line: the workflow, the run, the conclusion. The tool that prints it is
# `scripts/ci-verdict.py`, and this is where it is called from — a verdict
# that nobody reads is not a verdict, and the run id on its own is not one
# either (a repository has several workflows, and the one that says "success"
# may be the cache cleanup).
#
# It never fails the push, for two reasons that are both true most of the
# time: CI has not seen this commit yet — that is the usual answer for a first
# push — and a push may not depend on the network. The line is information;
# the verdict that blocks a push is the one above. The deadline belongs to
# the tool, which asks `gh` and gives up on its own: "a push must not depend
# on the network" is not true of a call that waits for the network to give up.
echo ""
echo "=== CI verdict (about the pushed ref tips) ==="
if ! command -v gh >/dev/null 2>&1; then
    echo "   ci verdict: SKIPPED (gh is not installed)"
elif ! python3 -c "import click" >/dev/null 2>&1; then
    echo "   ci verdict: SKIPPED (click is not installed)"
else
    # The repository the verdict is about: the one that receives the push.
    # The push url is that one; the fetch url is the fallback for a remote
    # that has no push url of its own, and for a push url that is not a
    # repository whose runs we can ask about. A remote that is not on GitHub
    # has no repository to ask about, so the step says so instead of asking
    # about somebody else's.
    #
    # The remote is the one git named in the first argument, not always
    # `origin`: a push to a fork asks about the fork.
    #
    # The urls are read from the configuration and not from `git remote
    # get-url`: that one expands the `insteadOf` rules, and the expanded url
    # of a developer who pushes to a mirror is not a GitHub url at all — the
    # step would skip, and the verdict would be lost. The configuration says
    # where the push is going.
    #
    # The first url is taken when there are several, because that is the one
    # `git remote get-url` named before.
    ci_verdict_args=()
    ci_verdict_repo=""
    ci_verdict_remote="$PUSH_REMOTE_NAME"
    ci_verdict_push_url="$(git config --get-all "remote.${ci_verdict_remote}.pushurl" 2>/dev/null | sed -n 1p || true)"
    ci_verdict_fetch_url="$(git config --get-all "remote.${ci_verdict_remote}.url" 2>/dev/null | sed -n 1p || true)"
    if [ -z "$ci_verdict_push_url" ] && [ -z "$ci_verdict_fetch_url" ]; then
        case "$ci_verdict_remote" in
            *://*|*@*:*)
                # A push to a url rather than to a named remote: git hands the
                # url over as the remote name too, and the configuration has
                # no entry for a url. The url is the repository the push
                # reaches, so it is the candidate — and it is the *expanded*
                # url, which is the one the push really goes to.
                ci_verdict_fetch_url="$ci_verdict_remote"
                ;;
            *)
                # A remote git named that the configuration does not describe:
                # the answer comes from `origin`, which is where most pushes
                # go, and the line below says which remote it asked about.
                ci_verdict_remote="origin"
                ci_verdict_push_url="$(git config --get-all remote.origin.pushurl 2>/dev/null | sed -n 1p || true)"
                ci_verdict_fetch_url="$(git config --get-all remote.origin.url 2>/dev/null | sed -n 1p || true)"
                ;;
        esac
    fi
    for candidate in "$ci_verdict_push_url" "$ci_verdict_fetch_url"; do
        case "$candidate" in
            *github.com[:/]*/*)
                ci_verdict_repo="$(printf '%s' "$candidate" | sed -E 's#.*github\.com[:/]+##; s#\.git$##')"
                ci_verdict_args=(--repo "$ci_verdict_repo")
                break
                ;;
        esac
    done
    if [ -z "$ci_verdict_repo" ]; then
        echo "   ci verdict: SKIPPED ($ci_verdict_remote is not a GitHub repository)"
    else
        # One line per pushed ref tip, and one line per commit that several
        # refs point at: two refs of one commit are one commit, and the answer
        # about it is one answer.
        ci_verdict_seen=""
        for sha in "${PUSH_LOCAL_SHAS[@]}"; do
            [ "$sha" != "$ZERO_SHA" ] || continue
            case "$ci_verdict_seen" in
                *"|$sha|"*) continue ;;
            esac
            ci_verdict_seen="$ci_verdict_seen|$sha|"
            ci_verdict_line="$(python3 "$REPO_ROOT/scripts/ci-verdict.py" "$sha" ${ci_verdict_args[@]+"${ci_verdict_args[@]}"} 2>&1 || true)"
            # The remote is named in the line: a reader who pushed to a fork
            # must be able to see that the answer is about the fork, and not
            # about the repository the clone came from.
            echo "   [$ci_verdict_remote] $ci_verdict_line"
        done
    fi
fi
echo ""

# ── Worktree shortcut ──────────────────────────────────────────────────
# In a worktree --git-dir differs from --git-common-dir.  Worktrees run their own
# cheap pre-push already; the full Gradle suite belongs only in CI.
#
# Both paths below end with the same marker. A marker that appears only on one
# path is a marker that a script reading the output has to know about, and the
# one script that reads this output is the one that has to decide whether the
# push may go ahead.
if [ "$(git rev-parse --git-dir)" != "$(git rev-parse --git-common-dir)" ]; then
    echo "=== Pre-push [$CURRENT_BRANCH] — worktree detected ==="
    echo "Structural gates OK (against the pushed tree). Detekt OK (about the pushed tree). Full suite runs in CI."
else
    echo "=== Pre-push [$CURRENT_BRANCH] — full suite delegated to CI ==="
    echo "Structural gates OK (against the pushed tree). Detekt OK (about the pushed tree). Full suite (jvmTest, desktopApp:test,"
    echo "kover, static-gates) runs in CI — no need to duplicate it here."
fi

echo "=== Pre-push OK ==="
