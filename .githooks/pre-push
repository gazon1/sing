#!/usr/bin/env bash
# Pre-push hook: fast gates + detekt auto-correct.
#
# The full Gradle test suite runs in CI, not here. Pre-push must be fast enough
# to run on every push without making people reach for --no-verify.
#
# What runs here vs. in CI:
#   Here:    structural gates (seconds) + the detekt verdict over the modules
#            the change can reach (a minute for a narrow change; ~9 min for a
#            change in `shared`, measured 2026-10-23 — the price is published
#            in docs/testing/gate-costs.md)
#   CI:      full suite — jvmTest, desktopApp:test, mcp-server:test,
#            kover, static-gates, Maestro flows
#
# WHAT IS CHECKED: the tree that is being pushed, not the checked-out worktree.
#
# WHAT IS NOT: the modules the change does not reach. The local verdict is
# partial — CI judges every module. The difference is written down in
# config/hooks/pre-push.json, and scripts/check-hook-gates.py keeps that record
# and this hook in step.
#
# `git push` hands the hook the refs it is about to write:
#     <local ref> <local sha> <remote ref> <remote sha>
# The local sha is the tree the remote will end up holding. The worktree is a
# different thing: `git push origin HEAD:other-branch` and a force-push of a
# rebuilt branch both push a tree the worktree does not hold, and a hook that
# gates the worktree reports green for a tree nobody pushed — and red for a
# tree that is fine. So every pushed local ref is checked out into a throwaway
# detached worktree, the structural gates run there, and the worktree is
# removed again.
#
# The detekt verdict is taken about the pushed tree as well. It is the only
# step that can run in the current worktree, and only when that worktree holds
# byte-identical content for everything detekt reads — then the worktree IS
# the pushed tree, and judging it there is warm: the Gradle daemon and the
# build directories are the ones this checkout has been using. When the
# worktree holds something else, the verdict is taken in a throwaway worktree
# at the pushed sha: a violation that is only in the worktree is then not
# reported as a violation of the tree being pushed, and a violation that IS in
# the pushed tree is not missed because the worktree happens to be clean.
#
# Runs on ALL branches (both main checkout and worktrees).
# Use `git push --no-verify` to skip this hook when needed (e.g., WIP commits).
# To disable entirely: git config --unset core.hooksPath

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

CURRENT_BRANCH="$(git rev-parse --abbrev-ref HEAD)"
ZERO_SHA="0000000000000000000000000000000000000000"

# ── The push description (stdin) ──────────────────────────────────────────
#
# One line per ref. It is read ONCE, here, and everything below works from
# the parsed values: a second read would find an empty stdin and silently
# validate nothing.
#
#   local sha all zeros  → the remote ref is being DELETED. No tree is pushed,
#                          so there is nothing to validate.
#   remote sha all zeros → the remote ref is new.
PUSH_REFS=()
PUSH_LOCAL_SHAS=()
PUSH_REMOTE_REFS=()
PUSH_REMOTE_SHAS=()
# The tree each pushed ref was checked out into — the empty string for a ref
# that was skipped (a deletion, a ref that is already up to date) or whose
# worktree could not be created.
REF_TREES=()
while read -r local_ref local_sha remote_ref remote_sha; do
    [ -n "${local_sha:-}" ] || continue
    PUSH_REFS+=("$local_ref")
    PUSH_LOCAL_SHAS+=("$local_sha")
    PUSH_REMOTE_REFS+=("${remote_ref:-}")
    PUSH_REMOTE_SHAS+=("${remote_sha:-}")
done

# ── Throwaway worktree management ─────────────────────────────────────────
#
# The tree being pushed is checked out in a detached worktree under a temp
# directory. It is removed on every exit path (trap), and the git metadata is
# pruned, so `git worktree list` does not accumulate entries.
TMP_ROOT=""
TEMP_WORKTREES=()

cleanup() {
    local rc=$?
    for t in ${TEMP_WORKTREES[@]+"${TEMP_WORKTREES[@]}"}; do
        git worktree remove --force "$t" >/dev/null 2>&1 || rm -rf "$t"
    done
    git worktree prune >/dev/null 2>&1 || true
    if [ -n "$TMP_ROOT" ]; then
        rm -rf "$TMP_ROOT"
    fi
    # 141 is SIGPIPE: a pipeline in this hook was closed before it finished
    # writing, and under `pipefail` the pipeline reports it. It is not a gate
    # verdict — the gates print their own — so it is named here rather than left
    # to be read as "the pre-push hook declined the push".
    if [ "$rc" = "141" ]; then
        echo "" >&2
        echo "pre-push: exited with 141 (SIGPIPE) — a pipeline here was closed early." >&2
        echo "This is a broken pipe, not a gate failure. If the push itself failed" >&2
        echo "with 141 and no output above, the cause is the transport (SSH), not this hook." >&2
    fi
    exit $rc
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

new_temp_root() {
    if [ -z "$TMP_ROOT" ]; then
        TMP_ROOT="$(mktemp -d "${TMPDIR:-/tmp}/pre-push-gate-XXXXXX")"
        # An empty hooks dir: `git worktree add` fires the post-checkout hook,
        # which would regenerate DIGEST.md inside the throwaway tree. The tree
        # under validation must be the tree that is being pushed, unchanged.
        mkdir -p "$TMP_ROOT/hooks"
        # The owning pid, so a later run can tell a dead run's leftovers from
        # a live run's worktree.
        echo "$$" > "$TMP_ROOT/pid"
    fi
}

# A hook that was SIGKILLed cannot run its trap, and a killed hook leaves its
# throwaway worktree registered in this repository's metadata. Left alone, those
# entries accumulate in `git worktree list` and in `.git/worktrees/`.
#
# So each run reaps the leftovers of DEAD runs before it starts. A temp worktree
# whose owning pid is still alive belongs to a concurrent push — it is left
# alone: removing it would pull the ground from under that push.
reap_stale_temp_worktrees() {
    local tree_path root pid
    while read -r tree_path; do
        root="$(dirname "$tree_path")"
        pid="$(cat "$root/pid" 2>/dev/null || true)"
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            continue
        fi
        echo "pre-push: removing a stale temporary worktree from a killed run ($tree_path)"
        git worktree remove --force "$tree_path" >/dev/null 2>&1 || rm -rf "$tree_path"
        rm -rf "$root"
    done < <(git worktree list --porcelain | sed -n 's/^worktree //p' | grep -E '/pre-push-gate-' || true)
    git worktree prune >/dev/null 2>&1 || true
}

reap_stale_temp_worktrees

# ── Holding the tree that is being pushed ───────────────────────────────
#
# A throwaway worktree per pushed tree, registered in TEMP_WORKTREES so the
# trap removes it on every exit path.
#
# The result is returned in CHECKOUT_TREE rather than on stdout: the caller
# prints the path itself, and a function that mixes a value and a message on
# one stream makes the caller guess which is which.
#
# The slot names the directory: a path that is already a registered worktree
# is refused by `git worktree add`, and a second ref must not inherit the
# first ref's tree.
CHECKOUT_TREE=""

checkout_pushed_tree() {
    local sha="$1" slot="$2" resolved candidate
    CHECKOUT_TREE=""
    resolved="$(git rev-parse --verify --quiet "${sha}^{commit}" 2>/dev/null || true)"
    if [ -z "$resolved" ]; then
        echo "   !!! $sha does not resolve to a commit in this repository"
        return 1
    fi
    new_temp_root
    candidate="$TMP_ROOT/tree-$slot"
    if git -c core.hooksPath="$TMP_ROOT/hooks" worktree add --detach --quiet \
        "$candidate" "$resolved" >"$TMP_ROOT/worktree-add.log" 2>&1; then
        TEMP_WORKTREES+=("$candidate")
        CHECKOUT_TREE="$candidate"
        return 0
    fi
    echo "   !!! could not create a temporary worktree for ${resolved:0:8}:"
    sed 's/^/       /' "$TMP_ROOT/worktree-add.log" || true
    return 1
}

# The worktree that holds a pushed sha, if one was already checked out.
tree_for_sha() {
    local sha="$1" j
    for j in "${!PUSH_REFS[@]}"; do
        if [ "${PUSH_LOCAL_SHAS[$j]}" = "$sha" ] && [ -n "${REF_TREES[$j]:-}" ]; then
            printf '%s' "${REF_TREES[$j]}"
            return 0
        fi
    done
    return 1
}

# ── Structural gates (seconds, no Gradle) ────────────────────────────────
#
# Both gates run against the TREE THAT IS BEING PUSHED. The gate scripts are
# the ones from this checkout — the checker is the current one, the way CI
# runs it — and they are pointed at the pushed tree.

GATES_FAILED=0

echo "=== Pre-push — structural gates (against the pushed tree) ==="

if [ "${#PUSH_REFS[@]}" -eq 0 ]; then
    echo "no refs in this push — nothing to validate"
fi

for i in "${!PUSH_REFS[@]}"; do
    local_ref="${PUSH_REFS[$i]}"
    local_sha="${PUSH_LOCAL_SHAS[$i]}"
    remote_ref="${PUSH_REMOTE_REFS[$i]}"
    remote_sha="${PUSH_REMOTE_SHAS[$i]}"

    if [ "$local_sha" = "$ZERO_SHA" ]; then
        echo ""
        echo "→ $local_ref → $remote_ref — deletion: no tree is pushed, skipped"
        continue
    fi

    if [ -n "$remote_sha" ] && [ "$local_sha" = "$remote_sha" ]; then
        echo ""
        echo "→ $local_ref → $remote_ref — already up to date, skipped"
        continue
    fi

    echo ""
    echo "→ $local_ref → $remote_ref @ $local_sha"

    tree=""
    if checkout_pushed_tree "$local_sha" "$i"; then
        tree="$CHECKOUT_TREE"
        echo "   pushed tree checked out in a temporary worktree (detached at ${local_sha:0:8})"
    fi
    REF_TREES[$i]="$tree"

    if [ -z "$tree" ]; then
        echo "   !!! FALLBACK — validating the CURRENT WORKTREE ($CURRENT_BRANCH) instead."
        echo "   !!! That is NOT the tree being pushed: this check does not cover the pushed content."
        tree="$REPO_ROOT"
    fi

    if (cd "$tree" && python3 "$REPO_ROOT/scripts/build-version-catalog-gate.py" --quiet .); then
        echo "   version-catalog gate: OK"
    else
        echo "   version-catalog gate: FAILED"
        GATES_FAILED=1
        echo ""
        echo "pre-push FAILED — hardcoded version literal in the tree of $local_ref."
        echo "Add it to gradle/libs.versions.toml and reference it via libs.*, or push with --no-verify."
    fi

    if [ ! -d "$tree/Maestro/flows" ]; then
        echo "   maestro selector gate: SKIPPED (this tree has no Maestro/flows)"
    elif (cd "$tree" && python3 "$REPO_ROOT/scripts/ci/validate-maestro-selectors.py" Maestro/flows); then
        echo "   maestro selector gate: OK"
    else
        echo "   maestro selector gate: FAILED"
        GATES_FAILED=1
        echo ""
        echo "pre-push FAILED — unknown id: selector in a Maestro flow in the tree of $local_ref."
        echo "Add it to TestTags.kt or DYNAMIC_EXPANSIONS / ALLOWLIST, or push with --no-verify."
    fi

    # The wait budgets: the instrumented suite and the Maestro flows wait for
    # the same screen and cannot share a constant. The gate is what keeps the
    # two copies of the number in step — and it is the gate that would have
    # caught the 8-second shell budget that kept `android-device-tests` red.
    #
    # It is skipped rather than failed when its dependencies are missing: a
    # gate that cannot run must not become a reason a push cannot happen, and
    # CI runs it either way.
    if ! python3 -c "import click" >/dev/null 2>&1; then
        echo "   ui wait budgets gate: SKIPPED (click is not installed)"
    elif (cd "$tree" && PYTHONPATH="$REPO_ROOT/scripts/src" \
        python3 "$REPO_ROOT/scripts/check-ui-wait-budgets.py" --root "$tree"); then
        echo "   ui wait budgets gate: OK"
    else
        echo "   ui wait budgets gate: FAILED"
        GATES_FAILED=1
        echo ""
        echo "pre-push FAILED — the UI wait budgets disagree in the tree of $local_ref."
        echo "Run python3 scripts/check-ui-wait-budgets.py to see where, or push with --no-verify."
    fi

    # The three rules that are cheap, that CI enforces, and that a contributor
    # would otherwise only meet as a red CI run: the pointers AGENTS.md names,
    # the registry entry of every change, and the review verdict of every
    # change.
    #
    # They run against the pushed tree, not the worktree, for the same reason
    # the gates above do: a rule that reads a different tree than the one
    # being pushed checks the wrong thing.
    #
    # The rule that runs is the one **in the pushed tree** — the same copy CI
    # would run, because CI runs the tree's own registry. Running today's
    # script against an older tree applies rules that did not exist when that
    # tree was written: a branch cut before this change would be blocked for
    # violations CI would never report on it. A tree that does not have the
    # rule does not have the rule, so the check is skipped and says so.
    #
    # Each rule costs well under a second — measured: the pointers gate 0.1 s,
    # the registry gate 1.1 s, the verdict gate 0.2 s — so the local loop
    # carries the same rules CI does, at a price nobody notices. The suite as a
    # whole is not in this hook on purpose: it is a minute and a half, and it
    # is where the incremental temptation lives. What is here is the part that
    # is cheap and that a broken tree would otherwise carry to CI.
    #
    # Skipped rather than failed when click is not installed, like the wait
    # budgets above: a gate that cannot run must not become a reason a push
    # cannot happen, and CI runs it either way.
    if ! python3 -c "import click" >/dev/null 2>&1; then
        echo "   tree rules gate: SKIPPED (click is not installed)"
    else
        # The rules come from the registry, so the hook and the test that
        # drives it cannot drift: a rule added to one and not the other was a
        # failing test, found by the full run rather than by the edit.
        TREE_RULES="$(cd "$REPO_ROOT" && PYTHONPATH="$REPO_ROOT/scripts/src" python3 -c \
            "from sgate.commands._registry import PRE_PUSH_TREE_RULES; print(' '.join(PRE_PUSH_TREE_RULES))" \
            2>/dev/null || echo '')"
        for rule in $TREE_RULES; do
            if [ ! -f "$tree/scripts/$rule.py" ]; then
                echo "   $rule gate: SKIPPED (the pushed tree does not have this rule)"
                continue
            fi
            if (cd "$tree" && PYTHONPATH="$REPO_ROOT/scripts/src" \
                python3 "$tree/scripts/$rule.py" --quiet); then
                echo "   $rule gate: OK"
            else
                echo "   $rule gate: FAILED"
                GATES_FAILED=1
                echo ""
                echo "pre-push FAILED — $rule found something in the tree of $local_ref."
                echo "Run python3 scripts/$rule.py to see where, or push with --no-verify."
            fi
        done
    fi

    # ── The gate suite's own tests ───────────────────────────────────────
    #
    # The test that caught a wrong timeout in the CI workflow lived in CI and
    # nowhere else: the local shield did not run it, so the mistake cost 33
    # minutes of CI instead of two and a half of local work. These tests are
    # what says the gates can fail — a gate suite nobody has run is a gate
    # suite that is green by accident.
    #
    # They run against the tree being pushed, like every other gate here: the
    # CI job that runs them runs the pushed tree's copies.
    if [ ! -d "$tree/scripts/tests" ]; then
        echo "   gate suite tests: SKIPPED (the pushed tree does not have them)"
    elif (cd "$tree" && PYTHONPATH="$tree/scripts/src" \
        python3 -m unittest discover -s scripts/tests >/dev/null 2>&1); then
        echo "   gate suite tests: OK"
    else
        echo "   gate suite tests: FAILED"
        GATES_FAILED=1
        echo ""
        echo "pre-push FAILED — the gate suite's own tests do not pass in the tree of $local_ref."
        echo "Run python3 -m unittest discover -s scripts/tests to see where, or push with --no-verify."
    fi

    # ── The promise files ─────────────────────────────────────────────────
    #
    # Some files in this repository promise something about the code next to
    # them, and each promise has been broken at least once — always in CI,
    # always hours later, always on somebody else's tree:
    #
    #   Maestro/TAGS.md                — the catalogue of the ids a flow may
    #                                     address, generated from TestTags.kt
    #   config/docs/maestro-flows.txt  — the catalogue of the flows themselves
    #   .specify/issues/*.yaml         — the registry of every openspec change
    #
    # A checker for each of them exists and costs seconds. What was missing was
    # the moment: the promise is kept when the file next to it changes, not
    # when CI eventually notices.
    #
    # So the check runs here, against the tree that is being pushed, and only
    # when that tree actually touches the file that carries the promise — a
    # push that touches nothing relevant pays nothing.
    #
    # The checkers are run FROM the pushed tree (`$tree/scripts/...`), because
    # each derives its repository root from its own file location: the copy in
    # the tree is the copy that knows about the tree.
    if [ -n "$remote_sha" ] && [ "$remote_sha" != "$ZERO_SHA" ]; then
        PROMISE_RANGE=("$remote_sha..$local_sha")
    else
        PROMISE_RANGE=("$local_sha" --not --remotes)
    fi
    # The files the pushed commits touch. `git log --name-only` rather than
    # `git diff`: the range is the pushed commits, and a file that a commit
    # touched is a file this push carries.
    PROMISE_TOUCHED="$(git log --name-only --pretty=format: "${PROMISE_RANGE[@]}" 2>/dev/null || true)"

    # promise_touched <path> — did this push touch that path?
    #
    # `grep -c` and not `grep -q`: `-q` closes the pipe on the first hit, the
    # writer takes SIGPIPE, and with `pipefail` the pipeline reports 141 —
    # which is a broken pipe, not an answer.
    promise_touched() {
        printf '%s\n' "$PROMISE_TOUCHED" | grep -c "^$1" >/dev/null
    }

    # The output of a promise check, kept for the failure message.
    #
    # The checkers import the gate CLI, whose logger writes a DEBUG line per
    # loaded module — noise that would bury the finding in a hook that people
    # read when they are trying to push. The output is captured instead of
    # streamed, and shown (without the DEBUG lines) only when the check fails.
    PROMISE_OUT="$(mktemp "${TMPDIR:-/tmp}/pre-push-promise-XXXXXX")"

    if promise_touched "shared/src/commonMain/kotlin/com/singularity/todo/core/ui/TestTags.kt$"; then
        if (cd "$tree" && PYTHONPATH="$tree/scripts/src" \
            python3 "$tree/scripts/check-test-tags-catalog.py" --check --quiet) \
            >"$PROMISE_OUT" 2>&1; then
            echo "   tag catalogue gate: OK"
        else
            echo "   tag catalogue gate: FAILED"
            GATES_FAILED=1
            echo ""
            echo "pre-push FAILED — Maestro/TAGS.md does not match TestTags.kt in the tree of $local_ref."
            sed '/DEBUG/d' "$PROMISE_OUT" | sed 's/^/   /'
            echo "Regenerate it: ./gradlew :shared:jvmTest -PupdateGoldens=true, or push with --no-verify."
        fi
    fi

    if promise_touched "Maestro/flows/" || promise_touched "config/docs/maestro-flows.txt$"; then
        if (cd "$tree" && PYTHONPATH="$tree/scripts/src" \
            python3 "$tree/scripts/check-maestro-flow-catalogue.py") \
            >"$PROMISE_OUT" 2>&1; then
            echo "   maestro flow catalogue gate: OK"
        else
            echo "   maestro flow catalogue gate: FAILED"
            GATES_FAILED=1
            echo ""
            echo "pre-push FAILED — the Maestro flow catalogue does not match the flows in the tree of $local_ref."
            sed '/DEBUG/d' "$PROMISE_OUT" | sed 's/^/   /'
            echo "Add the new flow to config/docs/maestro-flows.txt, or push with --no-verify."
        fi
    fi

    if promise_touched "openspec/changes/"; then
        if (cd "$tree" && PYTHONPATH="$tree/scripts/src" \
            python3 "$tree/scripts/check-issue-registry.py" --quiet) \
            >"$PROMISE_OUT" 2>&1; then
            echo "   issue registry gate: OK"
        else
            echo "   issue registry gate: FAILED"
            GATES_FAILED=1
            echo ""
            echo "pre-push FAILED — an openspec change in the tree of $local_ref has no record in .specify/issues/."
            sed '/DEBUG/d' "$PROMISE_OUT" | sed 's/^/   /'
            echo "Record it with: python3 scripts/openspec-import-all.py --replace, or push with --no-verify."
        fi
    fi

    rm -f "$PROMISE_OUT"
    # Two places where a commit can make a claim false and nothing says so.
    #
    # The DI fixture table says what to hand a Koin definition that takes its
    # arguments at runtime, and the navigation doc says what opens what. Both
    # are read by something else — a graph that is built, an agent that follows
    # a pointer — and both drifted on 2026-10-22 while the suite that would
    # have caught them was an hour away.
    #
    # They are text gates, so they cost seconds. The check is against the tree
    # being pushed, like every other gate here.
    if (cd "$tree" && PYTHONPATH="$tree/scripts/src" \
        python3 "$tree/scripts/check-di-fixture-sync.py" --root "$tree" --check); then
        echo "   DI fixture gate: OK"
    else
        echo "   DI fixture gate: FAILED"
        GATES_FAILED=1
        echo ""
        echo "pre-push FAILED — a Koin definition and the DI fixture table disagree in the tree of $local_ref."
        echo "Run python3 scripts/check-di-fixture-sync.py to see where, or push with --no-verify."
    fi

    if (cd "$tree" && PYTHONPATH="$tree/scripts/src" \
        python3 "$tree/scripts/check-navigation-doc-sync.py" --root "$tree" --check); then
        echo "   navigation doc gate: OK"
    else
        echo "   navigation doc gate: FAILED"
        GATES_FAILED=1
        echo ""
        echo "pre-push FAILED — the navigation doc claims something the code does not do in the tree of $local_ref."
        echo "Run python3 scripts/check-navigation-doc-sync.py to see where, or push with --no-verify."
    fi
done

if [ "$GATES_FAILED" = "1" ]; then
    echo ""
    echo "=== Pre-push FAILED — structural gates ==="
    exit 1
fi

echo ""
echo "=== Structural gates OK (against the pushed tree; a rule the pushed tree"
echo "    does not have is skipped, not checked) ==="
echo ""

# ── detekt verdict (about the tree that is being pushed) ────────────────
#
# The decision — which tree to judge, and whether the tree changed under
# detekt's feet — lives in scripts/pre-push-verdict.py, where it is
# unit-tested. It used to be bash here, with two branches nothing exercised.
#
# What the verdict means, in one paragraph: the tree that is being pushed is
# judged, not the worktree. The current worktree is judged when it holds
# byte-identical content for everything detekt can read — then it IS the
# pushed tree, and judging it there is warm (this checkout's own Gradle home
# and build directories). Otherwise a tree that holds the pushed content is
# judged, so a violation that is only in the worktree is not reported against
# a tree nobody pushed, and a violation that is in the pushed tree is not
# missed because the worktree happens to be clean.
#
# Two signals make the verdict red, and both are needed: the run's exit code
# (findings detekt could not correct) and the content digest before and after
# the run (findings it did correct — auto-correct rewrites the file and
# reports success, so what it changed is the only evidence of a violation).
#
# `--auto-correct` works (ADR 2026-10-17-detekt-auto-correct-works-use-it.md):
# one invocation per module (not a combined task list — the flag only reaches
# the last task of an invocation).
#
# `--rerun` forces re-analysis: without it Gradle is UP-TO-DATE and corrects
# nothing. `--rerun` re-runs the task it is given and leaves its dependencies
# alone, which is what makes this step affordable.
#
# `--rerun-tasks` was the flag here until 2026-10-20, and it is the reason the
# hook cost 8-10 minutes instead of the two the comment above it claims:
# `--rerun-tasks` re-runs the WHOLE task graph of the invocation, so every
# Kotlin compilation of `:shared` and `:desktopApp` was re-done from scratch on
# every push, only for detekt to re-analyse the sources that were compiled
# anyway. `--rerun` re-runs detekt alone.

echo "=== Pre-push [$CURRENT_BRANCH] — detekt verdict (about the pushed tree) ==="

DETEKT_FAILED=0
# How many trees were actually judged: a verdict that was not taken is not a
# clean verdict, and the summary must not claim otherwise.
DETEKT_JUDGED=0
# How many trees had nothing to judge — the change moved neither Kotlin nor
# rules. Nothing was checked there, so nothing was found: that is "not taken",
# not "clean".
DETEKT_NOTHING=0
judged_shas=" "

for i in "${!PUSH_REFS[@]}"; do
    local_ref="${PUSH_REFS[$i]}"
    local_sha="${PUSH_LOCAL_SHAS[$i]}"
    remote_ref="${PUSH_REMOTE_REFS[$i]}"
    remote_sha="${PUSH_REMOTE_SHAS[$i]}"

    if [ "$local_sha" = "$ZERO_SHA" ]; then
        continue                          # a deletion pushes no tree
    fi
    if [ -n "$remote_sha" ] && [ "$local_sha" = "$remote_sha" ]; then
        continue                          # already up to date: nothing is pushed
    fi
    case "$judged_shas" in
        *" $local_sha "*) continue ;;    # the same tree, judged once
    esac
    judged_shas="$judged_shas $local_sha "

    # Does this push carry Kotlin at all? Only the pushed commits count: the
    # verdict is about the pushed tree, and a Kotlin file that is only in the
    # worktree is not in it.
    #
    # The modules to judge are computed by scripts/pre-push-verdict.py from the
    # module graph: a change in one module judges that module and the ones
    # that compile against it, a change in the rules or in the build judges
    # every module, and a change that moves neither Kotlin nor rules needs no
    # detekt run at all. So the question "does this push carry Kotlin?" is
    # answered there, by the same code that decides what to judge — not here,
    # by a second rule that can disagree with it.
    echo ""
    echo "→ $local_ref → $remote_ref @ $local_sha"

    # The worktree this hook already checked out for this sha, if any: the
    # verdict falls back to it when the current worktree holds something else.
    fallback=""
    if [ -n "${REF_TREES[$i]:-}" ]; then
        fallback="${REF_TREES[$i]}"
    fi

    # The base of the pushed range: the tree the remote already holds. It is
    # what the change is measured against. A branch the remote does not have
    # yet is measured against the trunk instead (the script's default).
    base=""
    if [ -n "$remote_sha" ] && [ "$remote_sha" != "$ZERO_SHA" ]; then
        base="$remote_sha"
    fi

    new_temp_root
    verdict_rc=0
    verdict_out=""
    if [ -n "$base" ]; then
        verdict_out="$(python3 "$REPO_ROOT/scripts/pre-push-verdict.py" \
            --sha "$local_sha" \
            --repo "$REPO_ROOT" \
            --fallback-tree "$fallback" \
            --base "$base" \
            --log-dir "$TMP_ROOT/verdict")" || verdict_rc=$?
    else
        verdict_out="$(python3 "$REPO_ROOT/scripts/pre-push-verdict.py" \
            --sha "$local_sha" \
            --repo "$REPO_ROOT" \
            --fallback-tree "$fallback" \
            --log-dir "$TMP_ROOT/verdict")" || verdict_rc=$?
    fi
    printf '%s\n' "$verdict_out"

    # A verdict that found nothing to judge is not a verdict: nothing was
    # checked, so nothing was found. The summary says "not taken" rather than
    # "clean", because a clean tree is a claim and this is not one.
    case "$verdict_out" in
        *"nothing to judge"*) DETEKT_NOTHING=$((DETEKT_NOTHING + 1)) ;;
        *) DETEKT_JUDGED=$((DETEKT_JUDGED + 1)) ;;
    esac

    if [ "$verdict_rc" = "0" ]; then
        continue
    fi

    DETEKT_FAILED=1
    if [ "$verdict_rc" = "2" ]; then
        echo ""
        echo "pre-push FAILED — the detekt verdict could not be taken for $local_ref."
        echo "The tree that is being pushed was not judged, so this push is not certified."
        continue
    fi

    echo ""
    echo "pre-push FAILED — detekt reported findings in the tree that is being pushed ($local_ref)."
    echo "Fix them and push again (or push with --no-verify)."
done

if [ "$DETEKT_FAILED" = "1" ]; then
    echo ""
    echo "=== Pre-push FAILED — detekt verdict ==="
    exit 1
fi

echo ""
if [ "$DETEKT_JUDGED" = "0" ] && [ "$DETEKT_NOTHING" = "0" ]; then
    echo "detekt verdict: not taken — nothing was pushed to judge"
elif [ "$DETEKT_JUDGED" = "0" ]; then
    echo "detekt verdict: not taken — this change moves no Kotlin and no rules"
else
    echo "detekt verdict: the pushed tree is clean for the modules the change can affect"
    echo "detekt coverage: CI judges every module; the hook judges the ones this change reaches"
fi
echo ""


# ── Worktree shortcut ──────────────────────────────────────────────────
# In a worktree --git-dir differs from --git-common-dir.  Worktrees run their own
# cheap pre-push already; the full Gradle suite belongs only in CI.
#
# Both paths below end with the same marker. A marker that appears only on one
# path is a marker that a script reading the output has to know about, and the
# one script that reads this output is the one that has to decide whether the
# push may go ahead.
if [ "$(git rev-parse --git-dir)" != "$(git rev-parse --git-common-dir)" ]; then
    echo "=== Pre-push [$CURRENT_BRANCH] — worktree detected ==="
    echo "Structural gates OK (against the pushed tree). Detekt OK (about the pushed tree). Full suite runs in CI."
else
    echo "=== Pre-push [$CURRENT_BRANCH] — full suite delegated to CI ==="
    echo "Structural gates OK (against the pushed tree). Detekt OK (about the pushed tree). Full suite (jvmTest, desktopApp:test,"
    echo "kover, static-gates) runs in CI — no need to duplicate it here."
fi

echo "=== Pre-push OK ==="
