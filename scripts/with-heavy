#!/usr/bin/env bash
# Run a command through heavy if available and not in CI/nested; fallback otherwise.
# Usage: scripts/with-heavy <command> [args...]
if [[ $# -eq 0 ]]; then
  exit 1
fi
if command -v heavy >/dev/null 2>&1 && [[ -z "${CI:-}" ]] && [[ -z "${HEAVY_HELD:-}" ]]; then
  exec heavy -- "$@"
fi
exec "$@"
