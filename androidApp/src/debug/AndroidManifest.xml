<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Debug seed activity — enables Maestro flows to inject tasks, notes, and projects
      directly via deep-link without going through the UI. Lives in the debug source set
      so release APKs contain no trace of it.
    -->
    <application>
        <!--
          The host for instrumented Compose tests. `createAndroidComposeRule`
          launches it from the app under test's process, so the declaration has
          to live in the app's manifest, not in the test APK's — a test-APK
          declaration resolves to `com.singularity.todo.test` and the launch is
          rejected as a different process.
        -->
        <activity
            android:name="androidx.activity.ComponentActivity"
            android:exported="false" />

        <!--
          `singleTask` — the seed link has to reach *this* activity, always.

          Measured on the device: a seed link whose data equals the app task's
          base intent is not launched at all. Android hands it to the task's
          top activity instead — the running MainActivity, which knows nothing
          about seeds — and answers `result code=3` ("Activity not started,
          intent has been delivered to currently running top-most instance").
          The link is silently lost: no seed runs, no failure is shown, and the
          flow that sent it goes on. The base intent is the link that started
          the task, so the link that opens a run is the link a *second* run
          loses.

          `singleTask` routes the intent to this activity's own instance
          instead of to whatever is on top of the task, so a link cannot be
          delivered to an activity that will not act on it. The instance is
          gone after a seed (the activity finishes), so the system creates a
          fresh one — the seed runs, and `onNewIntent` covers the case where
          one is still alive.
        -->
        <activity
            android:name=".debug.DebugSeedActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="todo-debug"
                    android:host="seed" />
            </intent-filter>
        </activity>
    </application>

</manifest>
