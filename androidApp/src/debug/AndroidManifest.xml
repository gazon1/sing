<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Debug seed activity — enables Maestro flows to inject tasks, notes, and projects
      directly via deep-link without going through the UI. Lives in the debug source set
      so release APKs contain no trace of it.
    -->
    <application>
        <!--
          The host for instrumented Compose tests. `createAndroidComposeRule`
          launches it from the app under test's process, so the declaration has
          to live in the app's manifest, not in the test APK's — a test-APK
          declaration resolves to `com.singularity.todo.test` and the launch is
          rejected as a different process.
        -->
        <activity
            android:name="androidx.activity.ComponentActivity"
            android:exported="false" />

        <activity
            android:name=".debug.DebugSeedActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="todo-debug"
                    android:host="seed" />
            </intent-filter>
        </activity>
    </application>

</manifest>
