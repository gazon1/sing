<?xml version="1.0" encoding="utf-8"?>
<!--
  The ids of the debug-only views a test can address.

  The seed failure screen is the one that needs a handle: a flow that seeded
  something that could not be seeded has to be able to say "the seed failed"
  rather than time out on the app it never got. The id is what a flow
  addresses; the text on the view is the reason.
-->
<resources>
    <item name="seed_failure_reason" type="id" />
</resources>
