# AppTracer (pro crash reporting)
# Get these from your AppTracer project settings
TRACER_APP_TOKEN=
TRACER_PLUGIN_TOKEN=

# Gradle configuration-cache encryption key
# MUST be a base64-encoded AES key. Gradle requires base64, not hex —
# `openssl rand -hex 32` produces a 32-byte hex string and Gradle reads it as
# 32 raw bytes, which is not a key it accepts either way. A hex key is what
# left every workflow failing with "Invalid AES key length" (#391).
openssl rand -base64 16
GRADLE_ENCRYPTION_KEY=
# Used by setup-jvm-gradle to encrypt the configuration cache.
# Required for the coverage gate to prove results came from this run.
# Add as GitHub Actions secret: GRADLE_ENCRYPTION_KEY
