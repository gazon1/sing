#!/usr/bin/env bash
#
# ./sg — the gate suite of THIS checkout.
#
#   ./sg whereami
#   ./sg run-all --summary
#   ./sg gate <name>          # a single gate of this checkout
#
# WHY
#
# `sgate` on PATH is an editable install, and the install belongs to whichever
# checkout ran `setup-local-tools.sh` last. On this machine it pointed at
# another clone for a whole afternoon: the gates ran against *that* tree, every
# finding they produced was about a repository nobody was working on, and the
# only symptom was that the findings made no sense.
#
# PYTHONPATH alone is not the whole answer. A modern editable install
# registers a *meta-path finder* that maps `sgate` to the checkout that was
# installed last. Setuptools appends it to `sys.meta_path`, so a `sys.path`
# entry wins while it is there — but the plain `sgate` on PATH has no such
# entry, and the import resolves to the foreign clone. This wrapper drops any
# editable finder and puts this checkout's `scripts/src` first, so the answer
# does not depend on the setuptools version that installed it. That is the same
# move `./gw` makes with this worktree's Gradle home.
#
# The move itself lives in `scripts/package-binding.py`, which the gate suite's
# runner uses too — one place that knows how to bind the package, loaded by
# path, because the package may be the thing that is broken.
#
# WHAT IT PROVES
#
#   ./sg whereami        # the checkout this sgate belongs to
#
# If that prints a path outside this repository, the wrapper is broken and the
# gates are measuring somebody else's tree.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export SGATE_CHECKOUT="$root"

exec "${SGATE_PYTHON:-python3}" - "$@" <<'PYTHON'
import importlib.util
import os
import sys

root = os.environ["SGATE_CHECKOUT"]

# The binding is one module, loaded by path: the package may be the thing
# that is broken, so the thing that fixes it cannot live inside it. The
# runner (`scripts/run-gate-tests.py`) reaches the same module the same way.
spec = importlib.util.spec_from_file_location(
    "package_binding", os.path.join(root, "scripts", "package-binding.py")
)
binding = importlib.util.module_from_spec(spec)
spec.loader.exec_module(binding)
binding.bind_local_package(root)

sys.argv[0] = "sgate"

from sgate.cli import main

main()
PYTHON
