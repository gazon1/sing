#!/usr/bin/env bash
#
# ./sg — the gate suite of THIS checkout.
#
#   ./sg whereami
#   ./sg run-all --summary
#   ./sg gate <name>          # a single gate of this checkout
#
# WHY
#
# `sgate` on PATH is an editable install, and the install belongs to whichever
# checkout ran `setup-local-tools.sh` last. On this machine it pointed at
# another clone for a whole afternoon: the gates ran against *that* tree, every
# finding they produced was about a repository nobody was working on, and the
# only symptom was that the findings made no sense.
#
# `scripts/checkout-entry.py` is where that is answered: it drops any editable
# finder and puts this checkout's `scripts/src` first, through
# `scripts/package-binding.py`. This wrapper says only which entry point it
# serves — the gate CLI — and hands over to it.
#
# WHAT IT PROVES
#
#   ./sg whereami        # the checkout this sgate belongs to
#
# If that prints a path outside this repository, the wrapper is broken and the
# gates are measuring somebody else's tree.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export SGATE_CHECKOUT="$root"

exec "${SGATE_PYTHON:-python3}" - "$@" <<'PYTHON'
import importlib.util
import os

root = os.environ["SGATE_CHECKOUT"]

# The runner is loaded by path for the same reason it loads the binding that
# way: the packages may be the thing that is broken, so the thing that repairs
# them cannot be imported from them. A loader cannot load itself, so these few
# lines are the wrapper's own — everything else it needs is in that one file.
spec = importlib.util.spec_from_file_location(
    "checkout_entry", os.path.join(root, "scripts", "checkout-entry.py")
)
runner = importlib.util.module_from_spec(spec)
spec.loader.exec_module(runner)

runner.bind(root)

# The gate CLI answers "which checkout is this?" itself (`./sg whereami`), so
# this wrapper offers no answer of its own and hands over unchecked.
runner.run_entry_point("sgate", "sgate.cli")
PYTHON
