    <!-- The recurrence sentence. A rule is read, not printed: the task detail row
         and the picker's preview both say "Every 3 days, from the due date", never
         "Interval(base=FROM_DUE, amount=3, unit=DAY)". The count is pluralized per
         unit, and the singular is a string of its own because "Every 1 day" is not
         what a person says — "Every day" is. -->
    <string name="recurrence_every_day">Every day</string>
    <string name="recurrence_every_week">Every week</string>
    <string name="recurrence_every_month">Every month</string>
    <string name="recurrence_every_year">Every year</string>
