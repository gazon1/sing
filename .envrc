# direnv: private Gradle user home for this worktree.
#
# Equivalent to running ./gw, for people who prefer their editor's Gradle
# invocation to be the real one. The symlinks that avoid re-downloading the
# distribution, the caches and the toolchain JDK are created by ./gw; create
# them by hand if you use .envrc on its own:
#
#   mkdir -p .gradle-user-home
#   ln -sfn ~/.gradle/wrapper .gradle-user-home/wrapper
#   ln -sfn ~/.gradle/jdks    .gradle-user-home/jdks
#   mkdir -p .gradle-user-home/caches
#   for e in ~/.gradle/caches/*; do ln -sfn "$e" ".gradle-user-home/caches/$(basename "$e")"; done
#
# The per-Gradle-version cache directory is one level deeper: it is a real
# directory whose entries are links, and its `cc-keystore/` is private, because
# two worktrees must not open one keystore under one lock. Prefer running
# scripts/setup-gradle-home.sh over doing this by hand — it gets the nested
# layout right.
#
# See gw and docs/decisions/2026-10-04-gradle-daemon-isolation.md.
export GRADLE_USER_HOME="${PWD}/.gradle-user-home"
