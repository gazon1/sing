# direnv: private Gradle user home for this worktree.
#
# Equivalent to running ./gw, for people who prefer their editor's Gradle
# invocation to be the real one. The layout is created by
# scripts/setup-gradle-home.sh — it is idempotent and safe to run on every
# shell entry:
#
#   export GRADLE_USER_HOME="$(./scripts/setup-gradle-home.sh)"
#
# Do not create the links by hand. A Gradle version's cache directory is one
# level deeper than a link: it is a real directory whose entries are links, and
# its `cc-keystore/` is private, because two worktrees must not open one
# keystore under one lock. The script gets the nested layout right.
#
# See gw and docs/decisions/2026-10-04-gradle-daemon-isolation.md.
export GRADLE_USER_HOME="$(./scripts/setup-gradle-home.sh)"
